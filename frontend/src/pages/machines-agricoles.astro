---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Machines agricoles — Autohaus"
  description="Tracteurs, engins et matériel agricole. Contactez-nous pour connaître les disponibilités et obtenir un devis."
  i18nTitle="meta.title_agri"
  footer={{
    nav: ['home', 'vehicles'],
    services: [],
    contactWhatsapp: false,
    contactAddress: false,
    tagline: 'default',
    legal: 'short',
  }}
>
  <section class="page-hero">
    <div class="page-hero-bg">
      <img
        src="https://images.unsplash.com/photo-1581092160562-40aa08e78837?w=1920&q=80"
        alt="Machines agricoles"
      />
    </div>
    <div class="page-hero-overlay"></div>
    <div class="container">
      <span class="label">Machines agricoles</span>
      <h1>Matériel agricole</h1>
      <p>
        Tracteurs, engins et matériel agricole. Contactez-nous pour connaître
        les disponibilités et obtenir un devis personnalisé.
      </p>
      <div style="margin-top: 30px">
        <a href="contact.html" class="btn btn-primary btn-lg">Nous contacter</a>
      </div>
    </div>
  </section>
</Layout>
