---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Garantie — Autohaus"
  description="Garantie Autohaus : protection complète pour votre véhicule jusqu'à 24 mois, assistance 24/7."
  i18nTitle="meta.title_warranty"
  footer={{
    nav: ['home', 'vehicles'],
    services: ['warranty', 'delivery', 'maintenance'],
    contactWhatsapp: false,
    contactAddress: false,
    tagline: 'default',
    legal: 'short',
  }}
>
  <section class="page-hero">
    <div class="page-hero-bg">
      <img
        src="https://images.unsplash.com/photo-1503376780353-7e6692767b70?w=1920&q=80"
        alt="Garantie"
      />
    </div>
    <div class="page-hero-overlay"></div>
    <div class="container">
      <span class="label">Protection</span>
      <h1>Garantie Autohaus</h1>
      <p>
        Une protection complète pour votre véhicule avec des garanties
        étendues et une assistance 24/7. Roulez l'esprit tranquille.
      </p>
    </div>
  </section>

  <section style="padding: 60px 0">
    <div class="container">
      <div class="services-grid">
        <div class="service-card">
          <div class="service-icon">🛡️</div>
          <h3>Garantie incluse</h3>
          <p>
            12 mois ou 10 000 km. Protection moteur, boîte de vitesses et
            éléments essentiels. Incluse sur tous nos véhicules.
          </p>
        </div>
        <div class="service-card">
          <div class="service-icon">📅</div>
          <h3>Extension possible</h3>
          <p>
            Prolongez jusqu'à 24 ou 36 mois. Options d'assistance 24/7 et
            véhicule de remplacement disponibles.
          </p>
        </div>
        <div class="service-card">
          <div class="service-icon">🔧</div>
          <h3>Inspection 150 points</h3>
          <p>
            Chaque véhicule passe un contrôle technique approfondi avant
            livraison. Historique complet vérifié.
          </p>
        </div>
      </div>
      <div style="text-align: center; margin-top: 50px">
        <a href="vehicules.html" class="btn btn-primary btn-lg"
          >Voir les véhicules</a
        >
        <a
          href="assurance.html"
          class="btn btn-outline btn-lg"
          style="margin-left: 12px"
          >Assurances</a
        >
      </div>
    </div>
  </section>
</Layout>
