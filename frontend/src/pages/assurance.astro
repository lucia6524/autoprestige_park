---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Assurance — Autohaus"
  description="Solutions d'assurance auto sur mesure : responsabilité civile, tous risques, protection vol et incendie."
  i18nTitle="meta.title_insurance"
  footer={{
    nav: ['home', 'vehicles'],
    services: ['warranty', 'delivery', 'maintenance', 'insurance'],
    contactWhatsapp: false,
    contactAddress: false,
    tagline: 'default',
    legal: 'short',
  }}
>
  <section class="page-hero">
    <div class="page-hero-bg">
      <img
        src="https://images.unsplash.com/photo-1617814076367-b759c7d7e226?w=1920&q=80"
        alt="Assurance"
      />
    </div>
    <div class="page-hero-overlay"></div>
    <div class="container">
      <span class="label">Protection</span>
      <h1>Assurance véhicule</h1>
      <p>
        Des solutions d'assurance complètes adaptées à votre véhicule et à
        votre budget.
      </p>
    </div>
  </section>

  <section style="padding: 60px 0 100px">
    <div class="container">
      <div class="services-grid">
        <div class="service-card">
          <div class="service-icon">🛡️</div>
          <h3>Responsabilité Civile</h3>
          <p>
            Couverture obligatoire. Protection des tiers en cas d'accident.
          </p>
        </div>
        <div class="service-card">
          <div class="service-icon">💎</div>
          <h3>Tous Risques</h3>
          <p>
            Protection maximale : collision, vol, incendie, bris de glace,
            catastrophes naturelles.
          </p>
        </div>
        <div class="service-card">
          <div class="service-icon">🔒</div>
          <h3>Vol & Incendie</h3>
          <p>Options spécifiques pour sécuriser votre investissement.</p>
        </div>
      </div>
      <div style="text-align: center; margin-top: 50px">
        <a href="contact.html" class="btn btn-primary btn-lg"
          >Demander un devis assurance</a
        >
      </div>
    </div>
  </section>
</Layout>
