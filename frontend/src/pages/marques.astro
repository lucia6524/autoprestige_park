---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Nos Marques — Autohaus"
  description="Découvrez toutes les marques disponibles chez Autohaus : BMW, Mercedes, Audi, Porsche, Volkswagen et bien plus."
  i18nTitle="meta.title_brands"
  footer={{
    nav: ['home', 'vehicles'],
    services: [],
    contactWhatsapp: false,
    contactAddress: false,
    tagline: 'default',
    legal: 'short',
  }}
>
  <section class="page-hero">
    <div class="page-hero-bg">
      <img
        src="https://images.unsplash.com/photo-1555215695-3004980ad54e?w=1920&q=80"
        alt="Marques"
      />
    </div>
    <div class="page-hero-overlay"></div>
    <div class="container">
      <span class="label">Marques</span>
      <h1>Toutes les marques</h1>
      <p>
        Cliquez sur une marque pour découvrir les modèles disponibles dans
        notre catalogue.
      </p>
    </div>
  </section>

  <section style="padding: 60px 0 100px">
    <div class="container">
      <div class="section-header">
        <span class="label">Marques populaires</span>
        <h2>Nos marques phares</h2>
      </div>
      <div class="brands-grid">
        <a href="vehicules.html" class="brand-item"
          ><img
            src="https://cdn.simpleicons.org/bmw"
            alt="BMW"
            loading="lazy"
          /><span>BMW</span></a
        >
        <a href="vehicules.html" class="brand-item"
          ><img
            src="https://cdn.jsdelivr.net/npm/simple-icons@latest/icons/mercedes.svg"
            alt="Mercedes"
            loading="lazy"
          /><span>Mercedes-Benz</span></a
        >
        <a href="vehicules.html" class="brand-item"
          ><img
            src="https://cdn.simpleicons.org/audi"
            alt="Audi"
            loading="lazy"
          /><span>Audi</span></a
        >
        <a href="vehicules.html" class="brand-item"
          ><img
            src="https://cdn.simpleicons.org/porsche"
            alt="Porsche"
            loading="lazy"
          /><span>Porsche</span></a
        >
        <a href="vehicules.html" class="brand-item"
          ><img
            src="https://cdn.simpleicons.org/volkswagen"
            alt="VW"
            loading="lazy"
          /><span>Volkswagen</span></a
        >
        <a href="vehicules.html" class="brand-item"
          ><img
            src="https://cdn.simpleicons.org/tesla"
            alt="Tesla"
            loading="lazy"
          /><span>Tesla</span></a
        >
        <a href="vehicules.html" class="brand-item"
          ><img
            src="https://cdn.simpleicons.org/seat"
            alt="SEAT"
            loading="lazy"
          /><span>SEAT</span></a
        >
        <a href="vehicules.html" class="brand-item"
          ><img
            src="https://cdn.simpleicons.org/peugeot"
            alt="Peugeot"
            loading="lazy"
          /><span>Peugeot</span></a
        >
        <a href="vehicules.html" class="brand-item"
          ><img
            src="https://cdn.simpleicons.org/renault"
            alt="Renault"
            loading="lazy"
          /><span>Renault</span></a
        >
        <a href="vehicules.html" class="brand-item"
          ><img
            src="https://cdn.simpleicons.org/toyota"
            alt="Toyota"
            loading="lazy"
          /><span>Toyota</span></a
        >
        <a href="vehicules.html" class="brand-item"
          ><img
            src="https://cdn.simpleicons.org/honda"
            alt="Honda"
            loading="lazy"
          /><span>Honda</span></a
        >
        <a href="vehicules.html" class="brand-item"
          ><img
            src="https://cdn.simpleicons.org/volvo"
            alt="Volvo"
            loading="lazy"
          /><span>Volvo</span></a
        >
        <a href="vehicules.html" class="brand-item"
          ><img
            src="https://cdn.jsdelivr.net/npm/simple-icons@latest/icons/bentley.svg"
            alt="Bentley"
            loading="lazy"
          /><span>Bentley</span></a
        >
        <a href="vehicules.html" class="brand-item"
          ><img
            src="https://cdn.simpleicons.org/citroen"
            alt="Citroën"
            loading="lazy"
          /><span>Citroën</span></a
        >
        <a href="vehicules.html" class="brand-item"
          ><img
            src="https://cdn.jsdelivr.net/npm/simple-icons@latest/icons/ford.svg"
            alt="Ford"
            loading="lazy"
          /><span>Ford</span></a
        >
        <a href="vehicules.html" class="brand-item"
          ><img
            src="https://cdn.simpleicons.org/hyundai"
            alt="Hyundai"
            loading="lazy"
          /><span>Hyundai</span></a
        >
        <a href="vehicules.html" class="brand-item"
          ><img
            src="https://cdn.jsdelivr.net/npm/simple-icons@latest/icons/jaguar.svg"
            alt="Jaguar"
            loading="lazy"
          /><span>Jaguar</span></a
        >
        <a href="vehicules.html" class="brand-item"
          ><img
            src="https://cdn.simpleicons.org/kia"
            alt="Kia"
            loading="lazy"
          /><span>Kia</span></a
        >
        <a href="vehicules.html" class="brand-item"
          ><img
            src="https://cdn.jsdelivr.net/npm/simple-icons@latest/icons/landrover.svg"
            alt="Land Rover"
            loading="lazy"
          /><span>Land Rover</span></a
        >
        <a href="vehicules.html" class="brand-item"
          ><img
            src="https://cdn.simpleicons.org/mini"
            alt="MINI"
            loading="lazy"
          /><span>MINI</span></a
        >
        <a href="vehicules.html" class="brand-item"
          ><img
            src="https://cdn.simpleicons.org/nissan"
            alt="Nissan"
            loading="lazy"
          /><span>Nissan</span></a
        >
        <a href="vehicules.html" class="brand-item"
          ><img
            src="https://cdn.simpleicons.org/opel"
            alt="Opel"
            loading="lazy"
          /><span>Opel</span></a
        >
        <a href="vehicules.html" class="brand-item"
          ><img
            src="https://cdn.simpleicons.org/skoda"
            alt="Škoda"
            loading="lazy"
          /><span>Škoda</span></a
        >
      </div>
      <p
        style="text-align: center; margin-top: 40px; color: var(--text-secondary);"
      >
        Votre marque n'est pas dans la liste ?
        <a href="contact.html" style="color: var(--accent-light)"
          >Contactez-nous</a
        >, nous pouvons la trouver.
      </p>
    </div>
  </section>

  <style>
    .brand-card {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 28px 20px;
      text-align: center;
      font-weight: 600;
      font-size: 1.1rem;
      color: var(--text-primary);
      transition: var(--transition);
      min-width: 140px;
    }
    .brand-card:hover {
      border-color: var(--accent);
      transform: translateY(-4px);
      box-shadow: var(--shadow);
    }
  </style>
</Layout>
