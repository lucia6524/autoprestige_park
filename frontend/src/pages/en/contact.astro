---
// Version EN de contact.astro — contenu traduit AU BUILD (POC phase 1).
// La page FR reste la source de vérité structurelle : toute évolution de
// mise en page doit être répercutée ici (ou via un composant partagé en
// phase 2, voir docs/plan-seo-multilingue.md).
import LangLayout from '../../layouts/LangLayout.astro';
import { getDict, t } from '../../i18n/site';

const lang = 'en' as const;
const dict = getDict(lang);
---

<LangLayout
  lang={lang}
  file="contact.html"
  title={t(dict, 'meta.title_contact', 'Contact — Autohaus')}
  description="Contact the Autohaus team. A question, a purchase or a sale project? We are here to listen."
  footer={{
    nav: ['home', 'vehicles', 'financing', 'sell', 'contact'],
    services: ['warranty', 'delivery', 'maintenance', 'insurance'],
    contactWhatsapp: false,
    contactAddress: false,
    tagline: 'default',
    legal: 'short',
  }}
>
  <section class="page-hero">
    <div class="page-hero-bg">
      <img
        src="https://images.unsplash.com/photo-1563720223185-11003d516935?w=1920&q=80"
        alt="Contact"
      />
    </div>
    <div class="page-hero-overlay"></div>
    <div class="container">
      <span class="label">Contact us</span>
      <h1>Get in touch with our team</h1>
      <p>
        A question, a purchase or a sale project? Our team is here to listen.
      </p>
    </div>
  </section>

  <section class="contact" style="padding-top: 40px">
    <div class="container">
      <div class="contact-wrapper">
        <div class="contact-info">
          <h3>Let's talk about your next vehicle</h3>
          <p>
            Whether you are looking for a new vehicle, a recent used car or
            tailored financing, we are here for you.
          </p>

          <div class="contact-details">
            <div class="contact-item">
              <div class="contact-item-icon">📍</div>
              <div>
                <strong>Address</strong>
                <span data-site-address
                  >12 Avenue des Champs-Élysées, 75008 Paris, France</span
                >
              </div>
            </div>
            <div class="contact-item">
              <div class="contact-item-icon">📞</div>
              <div>
                <strong>Phone</strong>
                <span><a href="tel:+33142868200">+33 1 42 86 82 00</a></span>
              </div>
            </div>
            <div class="contact-item">
              <div class="contact-item-icon">✉️</div>
              <div>
                <strong>Email</strong>
                <span
                  ><a href="mailto:contact@autoprestige.fr"
                    >contact@autoprestige.fr</a
                  ></span
                >
              </div>
            </div>
            <div class="contact-item">
              <div class="contact-item-icon">🕒</div>
              <div>
                <strong>Opening hours</strong>
                <span
                  >Mon – Fri: 09:00 – 19:00<br />Saturday: 10:00 – 17:00</span
                >
              </div>
            </div>
          </div>
          <div
            class="contact-actions"
            style="display: flex; gap: 12px; margin-top: 24px; flex-wrap: wrap;"
          >
            <a
              href="https://wa.me/33142868200"
              target="_blank"
              rel="noopener"
              class="btn btn-primary"
              >WhatsApp</a
            >
            <a href="mailto:contact@autoprestige.fr" class="btn btn-outline"
              >Send us an email</a
            >
          </div>
        </div>

        <form class="contact-form" id="contact-form">
          <div class="form-row">
            <div class="form-group">
              <label for="name">Full name</label>
              <input
                type="text"
                id="name"
                name="name"
                placeholder="John Doe"
                required
              />
            </div>
            <div class="form-group">
              <label for="email">Email</label>
              <input
                type="email"
                id="email"
                name="email"
                placeholder="john@email.com"
                required
              />
            </div>
          </div>
          <div class="form-row">
            <div class="form-group">
              <label for="phone">Phone</label>
              <input
                type="tel"
                id="phone"
                name="phone"
                placeholder="+33 6 12 34 56 78"
              />
            </div>
            <div class="form-group">
              <label for="subject">Subject</label>
              <select id="subject" name="subject">
                <option value="info">Information request</option>
                <option value="essai">Test drive request</option>
                <option value="financement">Financing</option>
                <option value="reprise">Vehicle trade-in</option>
                <option value="autre">Other</option>
              </select>
            </div>
          </div>
          <div class="form-group">
            <label for="message">Message</label>
            <textarea
              id="message"
              name="message"
              placeholder="Describe your project or ask your question..."
              required
            ></textarea>
          </div>
          <button
            type="submit"
            class="btn btn-primary btn-lg"
            style="width: 100%"
          >
            Send the message
          </button>
          <p
            class="contact-form-feedback"
            id="contact-feedback"
            role="status"
            aria-live="polite"
          ></p>
        </form>
      </div>
    </div>
  </section>

  <script is:inline>
    // Même logique que la page FR (feedback inline) — libellés EN.
    document
      .getElementById('contact-form')
      ?.addEventListener('submit', async (event) => {
        event.preventDefault();
        const form = event.currentTarget;
        const button = form.querySelector('button[type=submit]');
        const feedback = document.getElementById('contact-feedback');
        const originalText = button.textContent;
        button.disabled = true;
        button.textContent = 'Sending...';
        feedback.className = 'contact-form-feedback';
        feedback.textContent = '';
        try {
          await API.sendContactMessage(Object.fromEntries(new FormData(form)));
          form.reset();
          feedback.className = 'contact-form-feedback success';
          feedback.textContent =
            'Your message has been sent. Our team will get back to you shortly.';
        } catch (error) {
          feedback.className = 'contact-form-feedback error';
          feedback.textContent = API.friendlyError(
            error,
            'Unable to send your message.'
          );
        } finally {
          button.disabled = false;
          button.textContent = originalText;
        }
      });
  </script>
</LangLayout>
