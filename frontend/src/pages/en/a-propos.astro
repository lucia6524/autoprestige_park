---
// Version EN de a-propos.astro — contenu traduit AU BUILD (POC phase 1).
// Les compteurs animés gardent leurs data-target (main.js s'en charge).
import LangLayout from '../../layouts/LangLayout.astro';
import { getDict, t } from '../../i18n/site';

const lang = 'en' as const;
const dict = getDict(lang);
---

<LangLayout
  lang={lang}
  file="a-propos.html"
  title={t(dict, 'meta.title_about', 'About us — Autohaus')}
  description="For more than 10 years, Autohaus has supported its customers with quality vehicles, expertise and a high-level after-sales service."
  footer={{
    nav: ['home', 'vehicles', 'contact'],
    services: ['warranty', 'delivery', 'maintenance'],
    contactWhatsapp: true,
    contactAddress: false,
    tagline: 'default',
    legal: 'short',
  }}
>
  <section class="page-hero">
    <div class="page-hero-bg">
      <img
        src="https://images.unsplash.com/photo-1449965401037-c41d9d6a0e8e?w=1920&q=80"
        alt="About Autohaus"
      />
    </div>
    <div class="page-hero-overlay"></div>
    <div class="container">
      <span class="label">About us</span>
      <h1 data-no-translate>Autohaus</h1>
      <p>
        For more than 10 years, we have been supporting our customers with
        quality vehicles, recognised expertise and after-sales service that
        lives up to expectations.
      </p>
      <div
        style="margin-top: 28px; display: flex; gap: 12px; justify-content: center; flex-wrap: wrap;"
      >
        <a href="../vehicules.html" class="btn btn-primary btn-lg"
          >Browse our catalogue</a
        >
        <a href="contact.html" class="btn btn-outline btn-lg"
          >Contact us</a
        >
      </div>
    </div>
  </section>

  <section style="padding: 60px 0; background: var(--bg-secondary)">
    <div class="container">
      <div class="stats-grid">
        <div class="stat-item">
          <strong data-target="2500" data-suffix="+">0</strong>
          <span>Vehicles sold</span>
        </div>
        <div class="stat-item">
          <strong data-target="4" data-suffix=".9★">0</strong>
          <span>Average rating</span>
        </div>
        <div class="stat-item">
          <strong data-target="14" data-suffix="+">0</strong>
          <span>Years of experience</span>
        </div>
      </div>
    </div>
  </section>

  <section style="padding: 80px 0">
    <div class="container" style="max-width: 900px">
      <div class="section-header">
        <span class="label">Our story</span>
        <h2>A passion for the automobile</h2>
      </div>
      <p
        style="color: var(--text-secondary); font-size: 1.1rem; line-height: 1.8; text-align: center; margin-bottom: 24px;"
      >
        Founded in 2012, Autohaus was built on a simple conviction: every
        customer deserves a quality vehicle, transparent support and
        impeccable service.
      </p>
      <p
        style="color: var(--text-secondary); font-size: 1.05rem; line-height: 1.8; text-align: center;"
      >
        Today, we offer a wide selection of carefully inspected new and used
        vehicles, tailored financing solutions and delivery across France and
        Europe. Our team makes a point of staying available before, during
        and after the sale.
      </p>
    </div>
  </section>

  <section style="padding: 0 0 100px">
    <div class="container">
      <div class="section-header">
        <span class="label">Our values</span>
        <h2>What guides us every day</h2>
      </div>
      <div class="services-grid">
        <div class="service-card">
          <div class="service-icon">🔍</div>
          <h3>Transparency</h3>
          <p>
            Full history, clear prices, no hidden fees. You know exactly what
            you are buying.
          </p>
        </div>
        <div class="service-card">
          <div class="service-icon">🛡️</div>
          <h3>Quality</h3>
          <p>
            Every vehicle goes through a thorough inspection. We only offer
            what we would recommend to our own family.
          </p>
        </div>
        <div class="service-card">
          <div class="service-icon">🤝</div>
          <h3>Support</h3>
          <p>
            From the search to financing through to delivery, a team devoted
            to your project.
          </p>
        </div>
      </div>
      <div style="text-align: center; margin-top: 50px">
        <a href="../vehicules.html" class="btn btn-primary btn-lg"
          >Discover our vehicles</a
        >
        <a
          href="https://wa.me/33142868200"
          target="_blank"
          rel="noopener"
          class="btn btn-outline btn-lg"
          style="margin-left: 12px"
          >WhatsApp</a
        >
      </div>
    </div>
  </section>
</LangLayout>
