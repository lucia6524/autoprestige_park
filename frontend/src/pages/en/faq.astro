---
// Version EN de faq.astro — contenu traduit AU BUILD (POC phase 1).
import LangLayout from '../../layouts/LangLayout.astro';
import { getDict, t } from '../../i18n/site';

const lang = 'en' as const;
const dict = getDict(lang);
---

<LangLayout
  lang={lang}
  file="faq.html"
  title={t(dict, 'meta.title_faq', 'FAQ — Autohaus')}
  description="Frequently asked questions about buying, selling, delivery and warranty at Autohaus."
  footer={{
    nav: ['home', 'vehicles'],
    services: ['warranty', 'delivery', 'maintenance'],
    contactWhatsapp: false,
    contactAddress: false,
    tagline: 'default',
    legal: 'short',
  }}
>
  <style is:global>
    .faq-item {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: 12px;
      margin-bottom: 12px;
      overflow: hidden;
    }
    .faq-question {
      padding: 20px 24px;
      font-weight: 600;
      cursor: pointer;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .faq-question:hover {
      color: var(--accent-light);
    }
    .faq-answer {
      padding: 0 24px 20px;
      color: var(--text-secondary);
      display: none;
    }
    .faq-item.open .faq-answer {
      display: block;
    }
  </style>

  <section class="page-hero">
    <div class="page-hero-bg">
      <img
        src="https://images.unsplash.com/photo-1494976388531-d1058494cdd8?w=1920&q=80"
        alt="FAQ"
      />
    </div>
    <div class="page-hero-overlay"></div>
    <div class="container">
      <span class="label">FAQ</span>
      <h1>Frequently asked questions</h1>
      <p>
        Everything you need to know about buying, selling, delivery and
        warranty.
      </p>
    </div>
  </section>

  <section style="padding: 60px 0 100px">
    <div class="container" style="max-width: 800px">
      <div class="faq-item">
        <div
          class="faq-question"
          onclick="this.parentElement.classList.toggle('open')"
        >
          What types of vehicles do you offer? <span>+</span>
        </div>
        <div class="faq-answer">
          We offer new vehicles, recent used cars and demonstration vehicles
          from all the major European and Asian brands.
        </div>
      </div>
      <div class="faq-item">
        <div
          class="faq-question"
          onclick="this.parentElement.classList.toggle('open')"
        >
          Are the vehicles covered by a warranty? <span>+</span>
        </div>
        <div class="faq-answer">
          Yes. All our used vehicles are sold with a minimum 12-month
          warranty. Extensions of up to 36 months are available.
        </div>
      </div>
      <div class="faq-item">
        <div
          class="faq-question"
          onclick="this.parentElement.classList.toggle('open')"
        >
          Do you offer financing? <span>+</span>
        </div>
        <div class="faq-answer">
          Yes. We work with several banking partners to offer financing
          solutions tailored to your situation (classic loans, lease and
          long-term rental).
        </div>
      </div>
      <div class="faq-item">
        <div
          class="faq-question"
          onclick="this.parentElement.classList.toggle('open')"
        >
          Do you deliver anywhere in France? <span>+</span>
        </div>
        <div class="faq-answer">
          Yes, we deliver throughout France and to most European countries.
          Transport is secure and insured.
        </div>
      </div>
      <div class="faq-item">
        <div
          class="faq-question"
          onclick="this.parentElement.classList.toggle('open')"
        >
          Can I trade in my old vehicle? <span>+</span>
        </div>
        <div class="faq-answer">
          Absolutely. We offer a free valuation and take your current vehicle
          in trade as part of a new purchase.
        </div>
      </div>
      <div class="faq-item">
        <div
          class="faq-question"
          onclick="this.parentElement.classList.toggle('open')"
        >
          How does payment work? <span>+</span>
        </div>
        <div class="faq-answer">
          Secure bank transfer or instalment payments by agreement. No hidden
          fees. Everything is clearly stated in the contract.
        </div>
      </div>
    </div>
  </section>
</LangLayout>
