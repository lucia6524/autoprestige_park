---
import Layout from '../layouts/Layout.astro';

// Même contenu + logique que la page HTML d'origine (catalogue + filtres).
// Le rendu de la grille est fait par js/main.js ; vehicles-thumbs.js et le
// repli local sont chargés comme sur les autres pages catalogue.
const footer = {
  nav: ['home', 'vehicles', 'financing', 'sell', 'contact'],
  services: ['warranty', 'delivery', 'maintenance', 'insurance'],
  contactWhatsapp: false,
  contactAddress: 'full',
  tagline: 'default',
  legal: 'full',
};
---

<Layout
  title="Catalogue Véhicules — Autohaus"
  description="Parcourez notre sélection de véhicules neufs et d'occasion. BMW, Mercedes, Audi, Porsche et plus encore."
  i18nTitle="meta.title_vehicles"
  footer={footer}
  scripts={['js/vehicles-thumbs.js']}
>
  <section class="page-hero">
    <div class="page-hero-bg">
      <img
        src="https://images.unsplash.com/photo-1492144534655-ae79c964c9d7?w=1920&q=80"
        alt="Catalogue véhicules"
      />
    </div>
    <div class="page-hero-overlay"></div>
    <div class="container">
      <span class="label">Catalogue</span>
      <h1>Nos Véhicules</h1>
      <p>
        Parcourez notre sélection de véhicules neufs et d'occasion
        soigneusement contrôlés.
      </p>
    </div>
  </section>

  <section
    class="vehicles"
    style="padding-top: 40px; background: var(--bg-primary); color: var(--text-primary)"
  >
    <div class="container">
      <div class="filters-panel">
        <div class="filters-row">
          <div class="filter-search">
            <input
              type="text"
              id="search-input"
              placeholder="Rechercher une marque ou un modèle..."
              data-i18n-placeholder="vehicles.search_placeholder"
            />
          </div>
          <select id="filter-brand" class="filter-select">
            <option value="all" data-i18n="vehicles.all_brands">
              Toutes les marques
            </option>
          </select>
          <select id="filter-fuel" class="filter-select">
            <option value="all" data-i18n="vehicles.all_fuels">
              Tous carburants
            </option>
            <option value="Essence" data-i18n="vehicles.fuel_petrol">
              Essence
            </option>
            <option value="Diesel" data-i18n="vehicles.fuel_diesel">
              Diesel
            </option>
            <option value="Hybride" data-i18n="vehicles.fuel_hybrid">
              Hybride
            </option>
            <option value="Électrique" data-i18n="vehicles.fuel_electric">
              Électrique
            </option>
          </select>
          <select id="filter-type" class="filter-select">
            <option value="all" data-i18n="vehicles.filter_type_all">Tous types</option>
            <option value="neuf" data-i18n="vehicles.filter_type_new">Neufs</option>
            <option value="occasion" data-i18n="vehicles.filter_type_used">Occasions</option>
          </select>
          <select id="filter-price" class="filter-select">
            <option value="all" data-i18n="vehicles.budget_max">Budget max</option>
            <option value="5000">≤ 5 000 €</option>
            <option value="8000">≤ 8 000 €</option>
            <option value="10000">≤ 10 000 €</option>
            <option value="15000">≤ 15 000 €</option>
            <option value="20000">≤ 20 000 €</option>
            <option value="30000">≤ 30 000 €</option>
          </select>
          <select id="filter-mileage" class="filter-select">
            <option value="all" data-i18n="vehicles.mileage_max">Kilométrage max</option>
            <option value="30000">≤ 30 000 km</option>
            <option value="60000">≤ 60 000 km</option>
            <option value="100000">≤ 100 000 km</option>
            <option value="150000">≤ 150 000 km</option>
            <option value="200000">≤ 200 000 km</option>
          </select>
          <label class="filter-checkbox">
            <input type="checkbox" id="filter-promo" /> <span data-i18n="vehicles.promo_only_checkbox">Promos uniquement</span>
          </label>
          <select id="sort-by" class="filter-select">
            <option value="default" data-i18n="vehicles.sort_default">Trier par</option>
            <option value="brand-asc" data-i18n="vehicles.sort_brand_asc">Marque (A → Z)</option>
            <option value="brand-desc" data-i18n="vehicles.sort_brand_desc">Marque (Z → A)</option>
            <option value="price-asc" data-i18n="vehicles.sort_price_asc">Prix croissant</option>
            <option value="price-desc" data-i18n="vehicles.sort_price_desc">Prix décroissant</option>
            <option value="year-desc" data-i18n="vehicles.sort_year_desc">Année (récent)</option>
            <option value="year-asc" data-i18n="vehicles.sort_year_asc">Année (ancien)</option>
          </select>
        </div>
        <div class="filters-result">
          <span id="results-count">0 véhicule(s)</span>
          <button id="reset-filters" class="btn-reset">Réinitialiser</button>
        </div>
      </div>

      <div class="vehicles-grid" id="vehicles-grid"></div>
    </div>
  </section>

  <script is:inline>
    // Catalogue de secours (291 Ko) : chargé uniquement si le cache local
    // est absent, expiré (> 30 min, cf. VEHICLES_CACHE_TTL de main.js) ou
    // illisible. Visites suivantes : 291 Ko économisés.
    (function () {
      var fresh = false;
      try {
        var raw = localStorage.getItem("autoprestige_vehicles_v1");
        if (raw) {
          var parsed = JSON.parse(raw);
          fresh = !!(parsed && parsed.ts && Date.now() - parsed.ts < 1800000);
        }
      } catch (e) { /* cache illisible → charger le repli */ }
      if (!fresh) {
        document.write('<script src="js/vehicles-data.js"><\/script>');
      }
    })();
  </script>
</Layout>