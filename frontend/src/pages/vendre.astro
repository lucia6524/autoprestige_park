---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Vendre mon véhicule — Autohaus"
  description="Vendez votre voiture au meilleur prix. Estimation gratuite et sans engagement. Offre sous 24h."
  footer={{
    nav: ['home', 'vehicles', 'financing', 'sell', 'contact'],
    services: ['warranty', 'delivery', 'maintenance', 'insurance'],
    contactWhatsapp: false,
    contactAddress: false,
    tagline: 'default',
    legal: 'short',
  }}
>
  <section class="hero" style="min-height: 70vh">
    <div class="hero-bg">
      <img
        src="https://images.unsplash.com/photo-1503376780353-7e6692767b70?w=1920&q=80"
        alt="Vendre voiture"
      />
    </div>
    <div class="hero-overlay"></div>
    <div class="container">
      <div class="hero-content">
        <div class="hero-badge">Vendre mon véhicule</div>
        <h1>
          Vendez votre voiture<br />au
          <span class="highlight">meilleur prix</span>
        </h1>
        <p>
          Estimation gratuite et sans engagement. Notre équipe évalue votre
          véhicule et vous propose la meilleure offre en 24h.
        </p>
        <div class="hero-buttons">
          <a href="#estimation" class="btn btn-primary btn-lg"
            >Estimer mon véhicule →</a
          >
          <a
            href="https://wa.me/33142868200"
            class="btn btn-outline btn-lg"
            target="_blank"
            >WhatsApp</a
          >
        </div>
      </div>
    </div>
  </section>

  <section id="estimation" style="padding: 80px 0">
    <div class="container">
      <div class="section-header">
        <span class="label">Estimation gratuite</span>
        <h2>Obtenez une offre en 24h</h2>
        <p>
          Remplissez le formulaire ci-dessous, nous vous recontactons
          rapidement avec une proposition sérieuse.
        </p>
      </div>

      <form
        class="contact-form"
        style="max-width: 700px; margin: 0 auto"
        id="sell-form"
        enctype="multipart/form-data"
      >
        <div class="form-row">
          <div class="form-group">
            <label>Marque</label>
            <input type="text" name="brand" placeholder="Ex : BMW" required />
          </div>
          <div class="form-group">
            <label>Modèle</label>
            <input type="text" name="model" placeholder="Ex : Série 3 320d" required />
          </div>
        </div>
        <div class="form-row">
          <div class="form-group">
            <label>Année</label>
            <input type="number" name="year" placeholder="2019" min="1950" max="2030" required />
          </div>
          <div class="form-group">
            <label>Kilométrage</label>
            <input type="number" name="mileage" placeholder="85000" min="0" required />
          </div>
        </div>
        <div class="form-row">
          <div class="form-group">
            <label>Votre nom</label>
            <input type="text" name="name" placeholder="Jean Dupont" required />
          </div>
          <div class="form-group">
            <label>Téléphone</label>
            <input type="tel" name="phone" placeholder="+33 6 12 34 56 78" required />
          </div>
        </div>
        <div class="form-group">
          <label>Photos du véhicule</label>
          <span
            style="font-size: 0.85rem; color: var(--text-muted)"
           
          >
            Cliquez pour ajouter des photos (max. 6)
          </span>
          <div
            style="font-size: 0.8rem; color: var(--text-muted); margin-top: 2px"
           
          >
            JPG, PNG, WebP — 1,5 Mo max par photo
          </div>
          <input
            type="file"
            name="photos"
            accept="image/jpeg,image/png,image/webp"
            multiple
            style="margin-top: 8px"
          />
        </div>
        <div class="form-group">
          <label>Email</label>
          <input type="email" name="email" placeholder="jean@email.com" required />
        </div>
        <div class="form-group">
          <label>Message (optionnel)</label>
          <textarea
            rows="3"
            name="notes"
            placeholder="Des informations complémentaires..."
          ></textarea>
        </div>
        <button
          type="submit"
          id="sell-submit"
          class="btn btn-primary btn-lg"
          style="width: 100%"
        >
          Envoyer la demande
        </button>
      </form>
    </div>
  </section>

  <script is:inline>
    // Envoi de la demande d'estimation vers POST /api/sell-requests
    // (photos redimensionnées côté client pour respecter la limite API).
    document.addEventListener("DOMContentLoaded", () => {
      const form = document.getElementById("sell-form");
      if (!form || !window.API) return;

      form.addEventListener("submit", async (e) => {
        e.preventDefault();
        const btn = document.getElementById("sell-submit");
        const original = btn ? btn.innerHTML : "";
        const fd = new FormData(form);
        const payload = {
          brand: (fd.get("brand") || "").toString().trim(),
          model: (fd.get("model") || "").toString().trim(),
          year: parseInt(fd.get("year"), 10) || 0,
          mileage: parseInt(fd.get("mileage"), 10) || 0,
          name: (fd.get("name") || "").toString().trim(),
          phone: (fd.get("phone") || "").toString().trim(),
          email: (fd.get("email") || "").toString().trim(),
          notes: (fd.get("notes") || "").toString().trim(),
          photos: [],
        };
        if (btn) {
          btn.disabled = true;
          btn.innerHTML = "Envoi en cours…";
        }
        try {
          const input = form.querySelector('input[type="file"]');
          const files = input ? Array.from(input.files || []) : [];
          if (files.length) {
            const resized = await Promise.all(
              files.slice(0, 6).map(resizeImage)
            );
            payload.photos = resized.filter(Boolean);
          }
          const result = await API.submitSellRequest(payload);
          Notify.success(
            result.message ||
              "Votre demande a bien été envoyée. Nous vous recontactons sous 24h.",
            { title: "Demande envoyée" },
          );
          form.reset();
        } catch (error) {
          Notify.error(
            (window.API ? API.friendlyError(error) : null) ||
              "L'envoi a échoué. Vérifiez votre connexion puis réessayez.",
            { title: "Erreur" },
          );
        } finally {
          if (btn) {
            btn.disabled = false;
            btn.innerHTML = original;
          }
        }
      });

      function resizeImage(file) {
        return new Promise((resolve) => {
          const reader = new FileReader();
          reader.onerror = () => resolve(null);
          reader.onload = () => {
            const img = new Image();
            img.onerror = () => resolve(null);
            img.onload = () => {
              const maxDim = 1200;
              let w = img.naturalWidth;
              let h = img.naturalHeight;
              if (w > maxDim || h > maxDim) {
                const ratio = Math.min(maxDim / w, maxDim / h);
                w = Math.round(w * ratio);
                h = Math.round(h * ratio);
              }
              const canvas = document.createElement("canvas");
              canvas.width = w;
              canvas.height = h;
              canvas.getContext("2d").drawImage(img, 0, 0, w, h);
              const out = canvas.toDataURL("image/jpeg", 0.82);
              // Limite API : 2 Mo par photo base64
              resolve(out.length <= 2000000 ? out : null);
            };
            img.src = reader.result;
          };
          reader.readAsDataURL(file);
        });
      }
    });
  </script>
</Layout>
