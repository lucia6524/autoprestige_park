            <div class="form-group">
              <label>Prix (€)</label
              ><input id="v-price" type="number" step="0.01" required />
            </div>
            <div class="form-group">
              <label>Mensualité (€)</label
              ><input id="v-monthly" type="number" step="0.01" value="0" />
            </div>
            <div class="form-group">
              <label>Kilométrage</label
              ><input id="v-mileage" type="number" value="0" />
            </div>
            <div class="form-group">
              <label>Carburant</label
              ><input id="v-fuel" placeholder="Diesel, Essence…" />
            </div>
            <div class="form-group">
              <label>Boîte</label
              ><input id="v-transmission" placeholder="Manuelle, Auto…" />
            </div>
            <div class="form-group">
              <label>Puissance (ch)</label
              ><input id="v-power" type="number" value="0" />
            </div>
            <div class="form-group">
              <label>Carrosserie</label
              ><input id="v-body" placeholder="Berline, SUV…" />
            </div>
            <div class="form-group" style="grid-column: 1/-1">
              <label>Image principale (URL)</label><input id="v-image" />
            </div>
            <div class="form-group" style="grid-column: 1/-1">
              <label>Description</label>
              <textarea
                id="v-description"
                rows="3"
                style="
                  width: 100%;
                  padding: 10px;
                  background: var(--bg2);
                  border: 1px solid var(--border);
                  border-radius: 8px;
                  color: var(--text);
                  font-family: inherit;
                "
              ></textarea>
            </div>
            <div
              style="
                grid-column: 1/-1;
                display: flex;
                gap: 12px;
                align-items: center;
              "
            >
              <label
                ><input type="checkbox" id="v-featured" /> À la une</label
              >
              <label><input type="checkbox" id="v-promo" /> Promo</label>
              <label><input type="checkbox" id="v-active" checked /> Actif</label>
            </div>
            <div style="grid-column: 1/-1; display: flex; gap: 10px">
              <button type="submit" class="btn btn-primary">
                Enregistrer
