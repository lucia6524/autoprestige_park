        <div class="panel">
          <div class="panel-header">
            <h3>Catalogue</h3>
            <input
              type="search"
              class="search-input"
              id="veh-search"
              placeholder="Marque ou modèle…"
            />
          </div>
          <div class="table-wrap">
            <table>
              <thead>
                <tr>
                  <th>ID</th>
                  <th>Catégorie</th>
                  <th>Véhicule</th>
                  <th>Année</th>
                  <th>Prix</th>
                  <th>Type</th>
                  <th>Actif</th>
                  <th>Actions</th>
                </tr>
              </thead>
              <tbody id="vehicles-tbody"></tbody>
            </table>
          </div>
        </div>
      </section>
    </main>
  </div>

  <div class="toast" id="toast"></div>

  <script is:inline>
    const configuredBase = localStorage.getItem("api_base");
    const isLocal = ["localhost", "127.0.0.1", "::1"].includes(
      window.location.hostname,
    );
    const API = configuredBase
      ? configuredBase.replace(/\\/$/, "") + "/api"
      : isLocal
        ? "http://127.0.0.1:8000/api"
        : "https://autoprestige-api.onrender.com/api";
    let token = localStorage.getItem("admin_token") || "";
    let currentUser = null;

    // ── Helpers ──────────────────────────────────────────
    function toast(msg, type = "success") {
      const el = document.getElementById("toast");
      el.textContent = msg;
      el.className = "toast show " + type;
      setTimeout(() => el.classList.remove("show"), 3200);
    }

    async function api(path, options = {}) {
      const headers = {
        "Content-Type": "application/json",
        ...(options.headers || {}),
      };
      const isLoginRequest = path === "/auth/login";
      if (token && !isLoginRequest)
        headers["Authorization"] = "Bearer " + token;
      const res = await fetch(API + path, { ...options, headers });
      if (res.status === 401) {
        if (!isLoginRequest) {
          logout();
          throw new Error("Session expirée");
        }
        const loginError = await res.json().catch(() => ({}));
        throw new Error(
          loginError.detail || "Email ou mot de passe incorrect.",
        );
      }
      const data = await res.json().catch(() => ({}));
      if (!res.ok)
        throw new Error(data.detail || data.message || "Erreur API");
      return data;
    }

    function formatPrice(n) {
      return new Intl.NumberFormat("fr-FR", {
        style: "currency",
        currency: "EUR",
        maximumFractionDigits: 0,
      }).format(n || 0);
    }

    // ⚠️ Sécurité XSS : toute donnée venant d'un utilisateur (nom, email,
    // message, véhicule…) est échappée avant insertion dans innerHTML.
    function escapeHtml(value) {
      const div = document.createElement("div");
      div.textContent = String(value == null ? "" : value);
      return div.innerHTML;
    }

    function formatDate(d) {
      if (!d) return "—";
      return new Date(d).toLocaleDateString("fr-FR", {
        day: "2-digit",
        month: "short",
        year: "numeric",
      });
    }

    function statusBadge(s) {
      const map = {
        pending: "badge-yellow",
        active: "badge-blue",
        paid: "badge-green",
        delivering: "badge-blue",
        delivered: "badge-green",
        cancelled: "badge-red",
      };
      return `<span class="badge ${map[s] || "badge-gray"}">${s}</span>`;
    }

    // ── Auth ─────────────────────────────────────────────
    async function login(email, password) {
      token = "";
      if (window.Loader) Loader.show();
      try {
        const data = await api("/auth/login", {
          method: "POST",
          body: JSON.stringify({ email, password }),
        });
        if (!data.user || !data.user.is_admin) {
          throw new Error("Ce compte n'a pas les droits administrateur");
        }
        token = data.access_token;
        currentUser = data.user;
        localStorage.setItem("admin_token", token);
        localStorage.setItem("admin_user", JSON.stringify(data.user));
        showApp();
      } finally {
        if (window.Loader) Loader.hide();
      }
    }

    function logout() {
      if (window.API && typeof API.revokeToken === "function") API.revokeToken(token);
      token = "";
      currentUser = null;
      localStorage.removeItem("admin_token");
      localStorage.removeItem("admin_user");
      document.getElementById("app").style.display = "none";
      document.getElementById("login-screen").style.display = "flex";
    }

    function showApp() {
      document.getElementById("login-screen").style.display = "none";
      document.getElementById("app").style.display = "block";
      if (currentUser) {
        document.getElementById("admin-name").textContent =
          currentUser.first_name + " " + currentUser.last_name;
        document.getElementById("admin-email").textContent =
          currentUser.email;
      }
      loadDashboard();
    }

    // ── Navigation ───────────────────────────────────────
    document.querySelectorAll(".sidebar-nav a[data-section]").forEach((a) => {
      a.addEventListener("click", (e) => {
        e.preventDefault();
        document
          .querySelectorAll(".sidebar-nav a")
          .forEach((x) => x.classList.remove("active"));
        a.classList.add("active");
        document
          .querySelectorAll(".section")
          .forEach((s) => s.classList.remove("active"));
        document
          .getElementById("section-" + a.dataset.section)
          .classList.add("active");
        if (a.dataset.section === "dashboard") loadDashboard();
        if (a.dataset.section === "users") loadUsers();
        if (a.dataset.section === "orders") loadOrders();
        if (a.dataset.section === "claims") loadClaims();
        if (a.dataset.section === "deliveries") loadDeliveries();
        if (a.dataset.section === "vehicles") loadVehicles();
        if (a.dataset.section === "reviews") loadReviews();
        if (a.dataset.section === "sell-requests") loadSellRequests();
        if (a.dataset.section === "settings") loadSiteSettings();
      });
    });

    // ── Site settings ───────────────────────────────────
    // Chaque champ est un formulaire autonome : enregistrer un champ ne touche
    // jamais les autres (l'API /site-settings fait une mise à jour partielle).
    const settingsForms = Array.from(
      document.querySelectorAll("form[data-sfield]"),
    );

    // Lien « Tester le numéro » du champ WhatsApp : ouvre wa.me avec le
    // numéro enregistré, pour vérification immédiate après chaque sauvegarde.
    const whatsappTestLink = document.getElementById("s-whatsapp-test");
    function updateWhatsappTestLink(value) {
      if (!whatsappTestLink) return;
      const digits = (value || "").replace(/[^0-9+]/g, "");
      if (digits) {
        whatsappTestLink.href = "https://wa.me/" + digits;
        whatsappTestLink.style.display = "inline";
      } else {
        whatsappTestLink.removeAttribute("href");
        whatsappTestLink.style.display = "none";
      }
    }

    async function loadSiteSettings() {
      try {
        const s = await api("/site-settings/admin");
        settingsForms.forEach((form) => {
          const input = form.querySelector("input");
          input.value = (s[form.dataset.sfield] || "").trim();
        });
        updateWhatsappTestLink(s.contact_whatsapp);
      } catch (e) {
        toast(e.message, "error");
      }
    }

    settingsForms.forEach((form) => {
      form.addEventListener("submit", async (e) => {
        e.preventDefault();
        const input = form.querySelector("input");
        const key = form.dataset.sfield;
        const value = input.value.trim();
        const label = (form.querySelector("label").firstChild.textContent || "").trim();
        form.classList.add("saving");
        if (window.Loader) Loader.show();
        try {
          const updated = await api("/site-settings", {
            method: "PUT",
            body: JSON.stringify({ [key]: value }),
          });
          if (updated && typeof updated[key] === "string")
            input.value = updated[key].trim();
          if (key === "contact_whatsapp")
            updateWhatsappTestLink(updated.contact_whatsapp);
          toast("« " + label + " » enregistré ✓");
        } catch (err) {
          toast(err.message, "error");
        } finally {
          form.classList.remove("saving");
          if (window.Loader) Loader.hide();
        }
      });
    });

    // ── Dashboard ────────────────────────────────────────
    async function loadDashboard() {
      try {
        const s = await api("/admin/stats");
        document.getElementById("stats-grid").innerHTML = `
          <div class="stat-card"><div class="label">Utilisateurs</div><div class="value blue">${s.users_total}</div></div>
          <div class="stat-card"><div class="label">Vérifiés</div><div class="value green">${s.users_verified}</div></div>
          <div class="stat-card"><div class="label">Commandes</div><div class="value purple">${s.orders_total}</div></div>
          <div class="stat-card"><div class="label">En attente</div><div class="value orange">${s.orders_pending}</div></div>
          <div class="stat-card"><div class="label">Actives</div><div class="value blue">${s.orders_active}</div></div>
          <div class="stat-card"><div class="label">Payées / livrées</div><div class="value green">${s.orders_paid}</div></div>
          <div class="stat-card"><div class="label">Revenu encaissé</div><div class="value green">${formatPrice(s.revenue_total)}</div></div>
          <div class="stat-card"><div class="label">Revenu en attente</div><div class="value orange">${formatPrice(s.revenue_pending)}</div></div>
        `;
      } catch (e) {
        toast(e.message, "error");
      }
    }

    // ── Users ────────────────────────────────────────────
    async function loadUsers(q = "") {
      try {
        const users = await api(
          "/admin/users" + (q ? "?q=" + encodeURIComponent(q) : ""),
        );
        const tbody = document.getElementById("users-tbody");
        if (!users.length) {
          tbody.innerHTML =
            '<tr><td colspan="9" class="empty">Aucun utilisateur</td></tr>';
          return;
        }
        tbody.innerHTML = users
          .map(
            (u) => `
          <tr>
            <td>#${u.id}</td>
            <td><strong>${escapeHtml(u.first_name)} ${escapeHtml(u.last_name)}</strong></td>
            <td>${escapeHtml(u.email)}</td>
            <td>${escapeHtml(u.phone || "—")}</td>
            <td>${u.is_verified ? '<span class="badge badge-green">Oui</span>' : '<span class="badge badge-red">Non</span>'}</td>
            <td>${u.is_active ? '<span class="badge badge-green">Oui</span>' : '<span class="badge badge-red">Non</span>'}</td>
            <td>${u.is_admin ? '<span class="badge badge-blue">Admin</span>' : "—"}</td>
            <td>${u.orders_count}</td>
            <td class="actions">
              <button class="btn btn-outline btn-sm" onclick="toggleActive(${u.id}, ${!u.is_active})">${u.is_active ? "Désactiver" : "Activer"}</button>
              ${!u.is_admin ? `<button class="btn btn-outline btn-sm" onclick="makeAdmin(${u.id})">Admin</button>` : ""}
              <button class="btn btn-danger btn-sm" onclick="deleteUser(${u.id}, '${escapeHtml(u.email)}')">Suppr.</button>
            </td>
          </tr>
        `,
          )
          .join("");
      } catch (e) {
        toast(e.message, "error");
      }
    }

    async function toggleActive(id, active) {
      try {
        await api("/admin/users/" + id, {
          method: "PATCH",
          body: JSON.stringify({ is_active: active }),
        });
        toast(active ? "Utilisateur activé" : "Utilisateur désactivé");
        loadUsers(document.getElementById("user-search").value);
      } catch (e) {
        toast(e.message, "error");
      }
    }

    async function makeAdmin(id) {
      if (!confirm("Donner les droits administrateur à cet utilisateur ?"))
        return;
      try {
        await api("/admin/users/" + id, {
          method: "PATCH",
          body: JSON.stringify({ is_admin: true }),
        });
        toast("Droits admin accordés");
        loadUsers(document.getElementById("user-search").value);
      } catch (e) {
        toast(e.message, "error");
      }
    }

    async function deleteUser(id, email) {
      if (!confirm("Supprimer définitivement " + email + " ?")) return;
      try {
        await api("/admin/users/" + id, { method: "DELETE" });
        toast("Utilisateur supprimé");
        loadUsers(document.getElementById("user-search").value);
      } catch (e) {
        toast(e.message, "error");
      }
    }

    // ── Orders ───────────────────────────────────────────
    async function loadOrders(status = "") {
      try {
        const orders = await api(
          "/admin/orders" + (status ? "?status=" + status : ""),
        );
        const tbody = document.getElementById("orders-tbody");
        if (!orders.length) {
          tbody.innerHTML =
            '<tr><td colspan="9" class="empty">Aucune commande</td></tr>';
          return;
        }
        tbody.innerHTML = orders
          .map(
            (o) => `
          <tr>
            <td>#${o.id}</td>
            <td>
              <strong>${escapeHtml(o.user_name || "—")}</strong><br>
              <span style="color:var(--muted);font-size:0.8rem">${escapeHtml(o.user_email)}</span>
            </td>
            <td>${escapeHtml(o.brand)} ${escapeHtml(o.model)} (${o.year})</td>
            <td>${formatPrice(o.total_price)}</td>
            <td>${formatPrice(o.amount_paid)}</td>
            <td>${o.payment_type === "monthly" ? "Mensuel (" + o.months_total + "m)" : "Comptant"}</td>
            <td>${statusBadge(o.status)}</td>
            <td>${formatDate(o.created_at)}</td>
            <td class="actions">
              <button class="btn btn-outline btn-sm" onclick='editDelivery(${JSON.stringify(o).replace(/'/g, "&#39;")})'>Gérer le suivi</button>
              <select class="status-select" onchange="changeOrderStatus(${o.id}, this.value)">
                <option value="">Changer…</option>
                <option value="pending">pending</option>
                <option value="active">active</option>
                <option value="paid">paid</option>
                <option value="delivering">delivering</option>
                <option value="delivered">delivered</option>
                <option value="cancelled">cancelled</option>
              </select>
            </td>
          </tr>
        `,
          )
          .join("");
      } catch (e) {
        toast(e.message, "error");
      }
    }

    async function loadDeliveries() {
      const tbody = document.getElementById("deliveries-tbody");
      try {
        const orders = await api("/admin/orders");
        const deliveries = orders.filter((o) => o.delivery_status);
        if (!deliveries.length) {
          tbody.innerHTML =
            '<tr><td colspan="7" class="empty">Aucune livraison disponible</td></tr>';
          return;
        }
        tbody.innerHTML = deliveries
          .map((o) => {
            const recipient = [o.recipient_first_name, o.recipient_last_name]
              .filter(Boolean)
              .join(" ");
            const destination = recipient
              ? `${escapeHtml(recipient)}<br><span style="color:var(--muted);font-size:.8rem">${escapeHtml(o.recipient_phone || "Téléphone non renseigné")}</span>`
              : "Adresse client à renseigner";
            const status = o.delivery_status || "preparing";
            return `<tr>
              <td>#${o.id}</td>
              <td><strong>${escapeHtml(o.user_name || "—")}</strong><br><span style="color:var(--muted);font-size:.8rem">${escapeHtml(o.user_email || "")}</span></td>
              <td>${escapeHtml(o.brand)} ${escapeHtml(o.model)}</td>
              <td>${destination}<br><span style="color:var(--muted);font-size:.8rem">${escapeHtml(o.delivery_address || "Adresse non renseignée")}</span></td>
              <td>${escapeHtml(o.tracking_number || "—")}<br><span style="color:var(--muted);font-size:.8rem">${escapeHtml(o.carrier || "—")}</span></td>
              <td>${statusBadge(status)}</td>
              <td class="actions">
                ${status !== "delivered" ? `<button class="btn btn-success btn-sm" onclick="validateDelivery(${o.id})">Valider livrée</button>` : ""}
                <button class="btn btn-outline btn-sm" onclick='editDelivery(${JSON.stringify(o).replace(/'/g, "&#39;")})'>Modifier</button>
              </td>
            </tr>`;
          })
          .join("");
      } catch (e) {
        toast(e.message, "error");
      }
    }

    async function validateDelivery(orderId) {
      if (!confirm("Confirmer que cette livraison a été effectuée ?")) return;
      try {
        await api("/admin/orders/" + orderId + "/delivery", {
          method: "PATCH",
          body: JSON.stringify({
            status: "delivered",
            event_message: "Livraison validée et effectuée.",
          }),
        });
        toast("Livraison validée ✓");
        loadDeliveries();
      } catch (e) {
        toast(e.message, "error");
      }
    }

    async function changeOrderStatus(id, status) {
      if (!status) return;
      try {
        await api("/admin/orders/" + id + "/status", {
          method: "PATCH",
          body: JSON.stringify({ status }),
        });
        toast("Statut mis à jour → " + status);
        loadOrders(document.getElementById("order-filter").value);
      } catch (e) {
        toast(e.message, "error");
      }
    }

    async function editDelivery(order) {
      const status = prompt(
        "Statut livraison (preparing, shipped, in_transit ou delivered) :",
        order.delivery_status || "preparing",
      );
      if (status === null) return;
      const tracking = prompt(
        "Numéro de suivi :",
        order.tracking_number || "",
      );
      if (tracking === null) return;
      const carrier = prompt("Transporteur :", order.carrier || "");
      if (carrier === null) return;
      const location = prompt(
        "Localisation actuelle :",
        order.current_location || "",
      );
      if (location === null) return;
      const notes = prompt("Note de livraison :", order.delivery_notes || "");
      if (notes === null) return;
      const estimated = prompt(
        "Date prévue (format ISO, exemple 2026-09-15T10:00:00) :",
        order.estimated_delivery ? order.estimated_delivery.slice(0, 16) : "",
      );
      if (estimated === null) return;
      try {
        await api("/admin/orders/" + order.id + "/delivery", {
          method: "PATCH",
          body: JSON.stringify({
            status: status.trim(),
            tracking_number: tracking.trim(),
            carrier: carrier.trim(),
            current_location: location.trim(),
            notes: notes.trim(),
            estimated_delivery: estimated.trim() || null,
            event_message:
              "Suivi de livraison mis à jour par l'administrateur.",
          }),
        });
        toast("Suivi de livraison mis à jour ✓");
        loadOrders(document.getElementById("order-filter").value);
      } catch (e) {
        toast(e.message, "error");
      }
    }

    // ── Events ───────────────────────────────────────────
    document
      .getElementById("login-form")
      .addEventListener("submit", async (e) => {
        e.preventDefault();
        const err = document.getElementById("login-error");
        err.classList.remove("show");
        try {
          await login(
            document.getElementById("email").value.trim(),
            document.getElementById("password").value,
          );
        } catch (ex) {
          err.textContent = ex.message || "Erreur de connexion";
          err.classList.add("show");
        }
      });

    document.getElementById("logout-btn").addEventListener("click", logout);

    let searchTimer;
    document.getElementById("user-search").addEventListener("input", (e) => {
      clearTimeout(searchTimer);
      searchTimer = setTimeout(() => {
        loadUsers(e.target.value);
      }, 300);
    });

    document
      .getElementById("order-filter")
      .addEventListener("change", (e) => {
        loadOrders(e.target.value);
      });

    document
      .getElementById("claims-filter")
      .addEventListener("change", (e) => {
        loadClaims(e.target.value);
      });

    document
      .getElementById("sellreq-filter")
      .addEventListener("change", (e) => {
        loadSellRequests(e.target.value);
      });

    document
      .getElementById("reviews-filter")
      .addEventListener("change", (e) => {
        loadReviews(e.target.value);
      });

    document
      .getElementById("veh-category-filter")
      .addEventListener("change", (e) => {
        loadVehicles(e.target.value);
      });

    let claimFilter = "";
    async function loadClaims(status = "") {
      claimFilter = status;
      try {
        const claims = await api(
          "/admin/claims" + (status ? "?status=" + status : ""),
        );
        const tbody = document.getElementById("claims-tbody");
        if (!claims.length) {
          tbody.innerHTML =
            '<tr><td colspan="7" class="empty">Aucune demande</td></tr>';
          return;
        }
        tbody.innerHTML = claims
          .map(
            (c) => `
          <tr>
            <td>${formatDate(c.due_date)}</td>
            <td><strong>${escapeHtml(c.user_name || "—")}</strong><br><span style="color:var(--muted);font-size:0.8rem">${escapeHtml(c.user_email)}</span></td>
            <td>${escapeHtml(c.brand)} ${escapeHtml(c.model)}</td>
            <td>${formatPrice(c.amount)}</td>
            <td>${formatDate(c.claimed_at)}</td>
            <td>${statusBadge(c.status)}</td>
            <td class="actions">
              ${c.status === "claimed" ? `<button class="btn btn-success btn-sm" onclick="validateClaim(${c.id})">Valider</button>
              <button class="btn btn-danger btn-sm" onclick="rejectClaim(${c.id})">Refuser</button>` : ""}
            </td>
          </tr>
        `,
          )
          .join("");
      } catch (e) {
        toast(e.message, "error");
      }
    }

    async function validateClaim(id) {
      try {
        await api("/admin/claims/" + id, {
          method: "PATCH",
          body: JSON.stringify({ status: "paid" }),
        });
        toast("Paiement validé ✓");
        loadClaims(claimFilter);
      } catch (e) {
        toast(e.message, "error");
      }
    }

    async function rejectClaim(id) {
      if (!confirm("Refuser cette demande de paiement ?")) return;
      try {
        await api("/admin/claims/" + id, {
          method: "PATCH",
          body: JSON.stringify({ status: "rejected" }),
        });
        toast("Demande refusée");
        loadClaims(claimFilter);
      } catch (e) {
        toast(e.message, "error");
      }
    }

    let sellReqFilter = "";
    async function loadSellRequests(status = "") {
      sellReqFilter = status;
      try {
        const requests = await api(
          "/admin/sell-requests" + (status ? "?status=" + status : ""),
        );
        const tbody = document.getElementById("sellreq-tbody");
        if (!requests.length) {
          tbody.innerHTML =
            '<tr><td colspan="8" class="empty">Aucune demande</td></tr>';
          return;
        }
        tbody.innerHTML = requests
          .map(
            (r) => `
          <tr>
            <td>#${r.id}</td>
            <td><strong>${escapeHtml(r.first_name)} ${escapeHtml(r.last_name)}</strong></td>
            <td>${escapeHtml(r.vehicle_brand)} ${escapeHtml(r.vehicle_model)}</td>
            <td>${(r.mileage || 0).toLocaleString("fr-FR")} km</td>
            <td>${r.photos_count || 0}</td>
            <td>${statusBadge(r.status)}</td>
            <td>${formatDate(r.created_at)}</td>
            <td class="actions">
              ${r.status === "new" ? `<button class="btn btn-outline btn-sm" onclick="updateSellRequest(${r.id}, 'contacted')">Contacter</button>
              <button class="btn btn-outline btn-sm" onclick="updateSellRequest(${r.id}, 'closed')">Clôturer</button>` : ""}
              ${r.status === "contacted" ? `<button class="btn btn-outline btn-sm" onclick="updateSellRequest(${r.id}, 'closed')">Clôturer</button>` : ""}
            </td>
          </tr>
        `,
          )
          .join("");
      } catch (e) {
        toast(e.message, "error");
      }
    }

    async function updateSellRequest(id, status) {
      try {
        await api("/admin/sell-requests/" + id, {
          method: "PATCH",
          body: JSON.stringify({ status }),
        });
        toast("Demande mise à jour");
        loadSellRequests(sellReqFilter);
      } catch (e) {
        toast(e.message, "error");
      }
    }

    let reviewFilter = "";
    async function loadReviews(status = "") {
      reviewFilter = status;
      try {
        const reviews = await api(
          "/admin/reviews" + (status ? "?status=" + status : ""),
        );
        const tbody = document.getElementById("reviews-tbody");
        if (!reviews.length) {
          tbody.innerHTML =
            '<tr><td colspan="8" class="empty">Aucun avis</td></tr>';
          return;
        }
        tbody.innerHTML = reviews
          .map(
            (r) => `
          <tr>
            <td>#${r.id}</td>
            <td><strong>${escapeHtml(r.name)}</strong></td>
            <td>${escapeHtml(r.vehicle || "—")}</td>
            <td>${"★".repeat(r.rating)} (${r.rating})</td>
            <td>${escapeHtml(r.message.slice(0, 60))}${r.message.length > 60 ? "…" : ""}</td>
            <td>${statusBadge(r.status)}</td>
            <td>${formatDate(r.created_at)}</td>
            <td class="actions">
              ${r.status === "pending" ? `<button class="btn btn-success btn-sm" onclick="approveReview(${r.id})">Approuver</button>
              <button class="btn btn-danger btn-sm" onclick="rejectReview(${r.id})">Refuser</button>` : ""}
            </td>
          </tr>
        `,
          )
          .join("");
      } catch (e) {
        toast(e.message, "error");
      }
    }

    async function approveReview(id) {
      try {
        await api("/admin/reviews/" + id, {
          method: "PATCH",
          body: JSON.stringify({ status: "approved" }),
        });
        toast("Avis approuvé ✓");
        loadReviews(reviewFilter);
      } catch (e) {
        toast(e.message, "error");
      }
    }

    async function rejectReview(id) {
      if (!confirm("Refuser cet avis ?")) return;
      try {
        await api("/admin/reviews/" + id, {
          method: "PATCH",
          body: JSON.stringify({ status: "rejected" }),
        });
        toast("Avis refusé");
        loadReviews(reviewFilter);
      } catch (e) {
        toast(e.message, "error");
      }
    }

    let vehFilter = "";
    async function loadVehicles(category = "") {
      vehFilter = category;
      try {
        const params = new URLSearchParams();
        if (category) params.set("category", category);
        const vehicles = await api("/admin/vehicles?" + params);
        const tbody = document.getElementById("vehicles-tbody");
        if (!vehicles.length) {
          tbody.innerHTML =
            '<tr><td colspan="8" class="empty">Aucun véhicule</td></tr>';
          return;
        }
        tbody.innerHTML = vehicles
          .map(
            (v) => `
          <tr>
            <td>#${v.id}</td>
            <td>${escapeHtml(v.category || "—")}</td>
            <td><strong>${escapeHtml(v.brand)} ${escapeHtml(v.model)}</strong></td>
            <td>${v.year}</td>
            <td>${formatPrice(v.price)}</td>
            <td>${v.type || "—"}</td>
            <td>${v.is_active ? '<span class="badge badge-green">Oui</span>' : '<span class="badge badge-red">Non</span>'}</td>
            <td class="actions">
              <button class="btn btn-outline btn-sm" onclick="editVehicle(${v.id})">Modifier</button>
              ${!v.is_active ? `<button class="btn btn-success btn-sm" onclick="toggleVehicleActive(${v.id})">Activer</button>` : `<button class="btn btn-danger btn-sm" onclick="toggleVehicleActive(${v.id})">Désactiver</button>`}
            </td>
          </tr>
        `,
          )
          .join("");
      } catch (e) {
        toast(e.message, "error");
      }
    }

    document
      .getElementById("btn-add-vehicle")
      .addEventListener("click", () => {
        document.getElementById("vehicle-form-panel").style.display = "block";
        document.getElementById("vehicle-form-title").textContent =
          "Nouveau véhicule";
        document.getElementById("v-id").value = "";
        document.getElementById("btn-cancel-vehicle").onclick = () => {
          document.getElementById("vehicle-form-panel").style.display = "none";
          document.getElementById("vehicle-form").reset();
        };
      });

    document
      .getElementById("vehicle-form")
      .addEventListener("submit", async (e) => {
        e.preventDefault();
        const isEdit = document.getElementById("v-id").value;
        const data = {
          category: document.getElementById("v-category").value,
          type: document.getElementById("v-type").value,
          brand: document.getElementById("v-brand").value.trim(),
          model: document.getElementById("v-model").value.trim(),
          year: parseInt(document.getElementById("v-year").value, 10),
          price: parseFloat(document.getElementById("v-price").value),
          monthly: parseFloat(document.getElementById("v-monthly").value) || 0,
          mileage: parseInt(document.getElementById("v-mileage").value, 10) || 0,
          fuel: document.getElementById("v-fuel").value.trim(),
          transmission: document.getElementById("v-transmission").value.trim(),
          power: parseInt(document.getElementById("v-power").value, 10) || 0,
          body: document.getElementById("v-body").value.trim(),
          image: document.getElementById("v-image").value.trim(),
          description: document.getElementById("v-description").value.trim(),
          featured: document.getElementById("v-featured").checked,
          promo: document.getElementById("v-promo").checked,
          is_active: document.getElementById("v-active").checked,
        };
        try {
          if (isEdit) {
            await api("/admin/vehicles/" + document.getElementById("v-id").value, {
              method: "PUT",
              body: JSON.stringify(data),
            });
            toast("Véhicule modifié ✓");
          } else {
            await api("/admin/vehicles", {
              method: "POST",
              body: JSON.stringify(data),
            });
            toast("Véhicule créé ✓");
          }
          document.getElementById("vehicle-form-panel").style.display = "none";
          document.getElementById("vehicle-form").reset();
          loadVehicles(vehFilter);
        } catch (e) {
          toast(e.message, "error");
        }
      });

    window.toggleVehicleActive = async (id) => {
      try {
        const vehicle = await api("/admin/vehicles/" + id);
        await api("/admin/vehicles/" + id, {
          method: "PATCH",
          body: JSON.stringify({ is_active: !vehicle.is_active }),
        });
        toast(
          vehicle.is_active ? "Véhicule désactivé" : "Véhicule activé",
        );
        loadVehicles(vehFilter);
      } catch (e) {
        toast(e.message, "error");
      }
    };

    window.editVehicle = async (id) => {
      try {
        const vehicle = await api("/admin/vehicles/" + id);
        document.getElementById("vehicle-form-panel").style.display = "block";
        document.getElementById("vehicle-form-title").textContent =
          "Modifier le véhicule";
        document.getElementById("v-id").value = vehicle.id;
        document.getElementById("v-category").value = vehicle.category || "";
        document.getElementById("v-type").value = vehicle.type || "";
        document.getElementById("v-brand").value = vehicle.brand || "";
        document.getElementById("v-model").value = vehicle.model || "";
        document.getElementById("v-year").value = vehicle.year || "";
        document.getElementById("v-price").value = vehicle.price || "";
        document.getElementById("v-monthly").value = vehicle.monthly || "";
        document.getElementById("v-mileage").value = vehicle.mileage || "";
        document.getElementById("v-fuel").value = vehicle.fuel || "";
        document.getElementById("v-transmission").value =
          vehicle.transmission || "";
        document.getElementById("v-power").value = vehicle.power || "";
        document.getElementById("v-body").value = vehicle.body || "";
        document.getElementById("v-image").value = vehicle.image || "";
        document.getElementById("v-description").value =
          vehicle.description || "";
        document.getElementById("v-featured").checked = vehicle.featured || false;
        document.getElementById("v-promo").checked = vehicle.promo || false;
        document.getElementById("v-active").checked = vehicle.is_active !== false;
        document.getElementById("btn-cancel-vehicle").onclick = () => {
          document.getElementById("vehicle-form-panel").style.display = "none";
          document.getElementById("vehicle-form").reset();
        };
      } catch (e) {
        toast(e.message, "error");
      }
    };
  </script>
</body>
</html>
