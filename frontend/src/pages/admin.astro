---
// Page admin autonome (pas de header/footer public) — même logique que la
// page HTML d'origine : styles propres + script inline, aucun JS externe.
export const prerender = true;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <link rel="icon" type="image/png" href="favicon.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Admin — Autohaus</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <style is:global>
    :root {
      --bg: #0b0b10;
      --bg2: #12121a;
      --card: #1a1a24;
      --border: rgba(255, 255, 255, 0.08);
      --text: #f4f4f5;
      --muted: #a1a1aa;
      --accent: #2563eb;
      --accent-h: #1d4ed8;
      --success: #22c55e;
      --warning: #f59e0b;
      --danger: #ef4444;
      --radius: 12px;
    }
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }
    body {
      font-family: "Inter", system-ui, sans-serif;
      background: var(--bg);
      color: var(--text);
      min-height: 100vh;
    }
    a {
      color: inherit;
      text-decoration: none;
    }

    /* Login */
    #login-screen {
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 24px;
      background: radial-gradient(ellipse at top, #1e1b4b 0%, var(--bg) 60%);
    }
    .login-card {
      width: 100%;
      max-width: 420px;
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 16px;
      padding: 40px 32px;
      box-shadow: 0 20px 60px rgba(0, 0, 0, 0.4);
    }
    .login-card h1 {
      font-size: 1.5rem;
      margin-bottom: 6px;
    }
    .login-card h1 span {
      color: #60a5fa;
    }
    .login-card p {
      color: var(--muted);
      font-size: 0.9rem;
      margin-bottom: 28px;
    }
    .form-group {
      margin-bottom: 18px;
    }
    .form-group label {
      display: block;
      font-size: 0.85rem;
      font-weight: 500;
      margin-bottom: 6px;
      color: var(--muted);
    }
    .form-group input {
      width: 100%;
      padding: 12px 14px;
      background: var(--bg2);
      border: 1px solid var(--border);
      border-radius: 8px;
      color: var(--text);
      font-size: 0.95rem;
      font-family: inherit;
      outline: none;
      transition: border-color 0.15s;
    }
    .form-group input:focus {
      border-color: var(--accent);
    }
    /* "Informations du site" : chaque champ est un formulaire autonome */
    .settings-fields {
      display: grid;
      gap: 10px;
      padding: 20px;
    }
    .settings-form {
      display: grid;
      grid-template-columns: 1fr auto;
      grid-template-areas: "label btn" "input btn";
      align-items: center;
      gap: 4px 14px;
      padding: 12px 14px;
      background: var(--bg);
      border: 1px solid var(--border);
      border-radius: 10px;
    }
    .settings-form label {
      grid-area: label;
      font-size: 0.85rem;
      font-weight: 500;
      color: var(--muted);
    }
    .settings-form input {
      grid-area: input;
      width: 100%;
      box-sizing: border-box;
      padding: 10px 12px;
      background: var(--bg2);
      border: 1px solid var(--border);
      border-radius: 8px;
      color: var(--text);
      font-size: 0.95rem;
      font-family: inherit;
      outline: none;
      transition: border-color 0.15s;
    }
    .settings-form input:focus {
      border-color: var(--accent);
    }
    .settings-form .btn-sm {
      grid-area: btn;
      width: auto;
      white-space: nowrap;
    }
    .settings-form.saving input {
      opacity: 0.6;
      pointer-events: none;
    }
    @media (max-width: 640px) {
      .settings-form {
        grid-template-columns: 1fr;
        grid-template-areas: "label" "input" "btn";
      }
      .settings-form .btn-sm {
        width: 100%;
      }
    }
    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      padding: 12px 20px;
      border: none;
      border-radius: 8px;
      font-weight: 600;
      font-size: 0.9rem;
      cursor: pointer;
      font-family: inherit;
      transition:
        background 0.15s,
        transform 0.1s;
    }
    .btn-primary {
      background: var(--accent);
      color: #fff;
      width: 100%;
    }
    .btn-primary:hover {
      background: var(--accent-h);
    }
    .btn-sm {
      padding: 7px 12px;
      font-size: 0.8rem;
    }
    .btn-outline {
      background: transparent;
      border: 1px solid var(--border);
      color: var(--text);
    }
    .btn-outline:hover {
      background: rgba(255, 255, 255, 0.05);
    }
    .btn-danger {
      background: var(--danger);
      color: #fff;
    }
    .btn-success {
      background: var(--success);
      color: #fff;
    }
    .error-msg {
      background: rgba(239, 68, 68, 0.15);
      border: 1px solid rgba(239, 68, 68, 0.3);
      color: #fca5a5;
      padding: 10px 14px;
      border-radius: 8px;
      font-size: 0.85rem;
      margin-bottom: 16px;
      display: none;
    }
    .error-msg.show {
      display: block;
    }

    /* Layout */
    #app {
      display: none;
      min-height: 100vh;
    }
    .sidebar {
      position: fixed;
      left: 0;
      top: 0;
      bottom: 0;
      width: 240px;
      background: var(--bg2);
      border-right: 1px solid var(--border);
      display: flex;
      flex-direction: column;
      z-index: 100;
    }
    .sidebar-brand {
      padding: 24px 20px;
      font-weight: 700;
      font-size: 1.15rem;
      border-bottom: 1px solid var(--border);
    }
    .sidebar-brand span {
      color: #60a5fa;
    }
    .sidebar-nav {
      flex: 1;
      padding: 16px 12px;
    }
    .sidebar-nav a {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 11px 14px;
      border-radius: 8px;
      font-size: 0.9rem;
      font-weight: 500;
      color: var(--muted);
      margin-bottom: 4px;
      transition:
        background 0.12s,
        color 0.12s;
    }
    .sidebar-nav a:hover,
    .sidebar-nav a.active {
      background: rgba(37, 99, 235, 0.15);
      color: #93c5fd;
    }
    .sidebar-footer {
      padding: 16px;
      border-top: 1px solid var(--border);
      font-size: 0.8rem;
      color: var(--muted);
    }
    .sidebar-footer .admin-name {
      color: var(--text);
      font-weight: 600;
      margin-bottom: 4px;
    }
    .main {
      margin-left: 240px;
      padding: 28px 32px;
      min-height: 100vh;
    }
    .page-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 28px;
      flex-wrap: wrap;
      gap: 12px;
    }
    .page-header h2 {
      font-size: 1.5rem;
      font-weight: 700;
    }
    .page-header p {
      color: var(--muted);
      font-size: 0.9rem;
      margin-top: 4px;
    }

    /* Stats cards */
    .stats-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
      gap: 16px;
      margin-bottom: 32px;
    }
    .stat-card {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 20px;
    }
    .stat-card .label {
      font-size: 0.8rem;
      color: var(--muted);
      margin-bottom: 8px;
    }
    .stat-card .value {
      font-size: 1.6rem;
      font-weight: 700;
    }
    .stat-card .value.blue {
      color: #60a5fa;
    }
    .stat-card .value.green {
      color: #4ade80;
    }
    .stat-card .value.orange {
      color: #fbbf24;
    }
    .stat-card .value.purple {
      color: #c084fc;
    }

    /* Table */
    .panel {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      overflow: hidden;
    }
    .panel-header {
      padding: 16px 20px;
      border-bottom: 1px solid var(--border);
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      flex-wrap: wrap;
    }
    .panel-header h3 {
      font-size: 1rem;
      font-weight: 600;
    }
    .search-input {
      padding: 8px 14px;
      background: var(--bg2);
      border: 1px solid var(--border);
      border-radius: 8px;
      color: var(--text);
      font-size: 0.85rem;
      font-family: inherit;
      outline: none;
      min-width: 200px;
    }
    .search-input:focus {
      border-color: var(--accent);
    }
    .table-wrap {
      overflow-x: auto;
    }
    table {
      width: 100%;
      border-collapse: collapse;
      font-size: 0.875rem;
    }
    th {
      text-align: left;
      padding: 12px 16px;
      color: var(--muted);
      font-weight: 500;
      font-size: 0.75rem;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      border-bottom: 1px solid var(--border);
      white-space: nowrap;
    }
    td {
      padding: 14px 16px;
      border-bottom: 1px solid var(--border);
      vertical-align: middle;
    }
    tr:last-child td {
      border-bottom: none;
    }
    tr:hover td {
      background: rgba(255, 255, 255, 0.02);
    }
    .badge {
      display: inline-block;
      padding: 3px 10px;
      border-radius: 20px;
      font-size: 0.72rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.03em;
    }
    .badge-green {
      background: rgba(34, 197, 94, 0.15);
      color: #4ade80;
    }
    .badge-red {
      background: rgba(239, 68, 68, 0.15);
      color: #f87171;
    }
    .badge-yellow {
      background: rgba(245, 158, 11, 0.15);
      color: #fbbf24;
    }
    .badge-blue {
      background: rgba(37, 99, 235, 0.15);
      color: #60a5fa;
    }
    .badge-gray {
      background: rgba(161, 161, 170, 0.15);
      color: #a1a1aa;
    }
    .actions {
      display: flex;
      gap: 6px;
      flex-wrap: wrap;
    }
    .empty {
      text-align: center;
      padding: 48px 20px;
      color: var(--muted);
    }
    .section {
      display: none;
    }
    .section.active {
      display: block;
    }
    select.status-select {
      padding: 6px 10px;
      background: var(--bg2);
      border: 1px solid var(--border);
      border-radius: 6px;
      color: var(--text);
      font-size: 0.8rem;
      font-family: inherit;
      cursor: pointer;
    }
    .toast {
      position: fixed;
      bottom: 24px;
      right: 24px;
      background: var(--card);
      border: 1px solid var(--border);
      padding: 14px 20px;
      border-radius: 10px;
      font-size: 0.9rem;
      box-shadow: 0 8px 30px rgba(0, 0, 0, 0.4);
      z-index: 9999;
      transform: translateY(100px);
      opacity: 0;
      transition: all 0.3s ease;
    }
    .toast.show {
      transform: translateY(0);
      opacity: 1;
    }
    .toast.success {
      border-left: 3px solid var(--success);
    }
    .toast.error {
      border-left: 3px solid var(--danger);
    }

    #vehicle-form .form-group label {
      display: block;
      font-size: 0.8rem;
      color: var(--muted);
      margin-bottom: 4px;
    }
    #vehicle-form .form-group input,
    #vehicle-form .form-group select {
      width: 100%;
      padding: 10px 12px;
      background: var(--bg2);
      border: 1px solid var(--border);
      border-radius: 8px;
      color: var(--text);
      font-family: inherit;
      font-size: 0.9rem;
    }
    @media (max-width: 768px) {
      .sidebar {
        width: 100%;
        height: auto;
        position: relative;
      }
      .main {
        margin-left: 0;
        padding: 20px 16px;
      }
      .sidebar-nav {
        display: flex;
        flex-wrap: wrap;
        gap: 4px;
        padding: 12px;
      }
      .sidebar-nav a {
        margin-bottom: 0;
      }
    }
  </style>
  <!-- Overlay loader : logo Autohaus qui tourne (voir js/loader.js) -->
  <script is:inline data-ap-loader>
    (function () {
      try {
        var css =
          "#ap-loader-overlay{position:fixed;inset:0;z-index:99999;" +
          "display:flex;align-items:center;justify-content:center;" +
          "background:rgba(9,9,14,.62);backdrop-filter:blur(4px);" +
          "opacity:0;pointer-events:none;transition:opacity .22s ease}" +
          "#ap-loader-overlay.show{opacity:1;pointer-events:auto}" +
          "#ap-loader-overlay .ap-logo-spin{width:92px;height:92px;" +
          "border-radius:50%;object-fit:contain;background:#fff;padding:12px;" +
          "box-shadow:0 8px 28px rgba(0,0,0,.18);animation:ap-spin 1.1s linear infinite}" +
          "@keyframes ap-spin{to{transform:rotate(360deg)}}" +
          "@media (prefers-reduced-motion:reduce){#ap-loader-overlay .ap-logo-spin{animation-duration:2.6s}}";
        var s = document.createElement('style');
        s.textContent = css;
        (document.head || document.documentElement).appendChild(s);
        var o = document.createElement('div');
        o.id = 'ap-loader-overlay';
        o.className = 'show';
        o.innerHTML =
          '<img class="ap-logo-spin" src="logo.png" alt="" aria-hidden="true">';
        document.documentElement.appendChild(o);
      } catch (e) {}
    })();
  </script>
  <script src="js/loader.js" defer is:inline></script>
</head>
<body>

  <!-- LOGIN -->
  <div id="login-screen">
    <div class="login-card">
      <h1>Auto<span>haus</span> Admin</h1>
      <p>Connectez-vous avec le compte administrateur</p>
      <div class="error-msg" id="login-error"></div>
      <form id="login-form">
        <div class="form-group">
          <label for="email">Email</label>
          <input
            type="email"
            id="email"
            required
            placeholder="admin@autoprestige.fr"
            autocomplete="username"
          />
        </div>
        <div class="form-group">
          <label for="password">Mot de passe</label>
          <input
            type="password"
            id="password"
            required
            placeholder="••••••••"
            autocomplete="current-password"
          />
        </div>
        <button type="submit" class="btn btn-primary">Se connecter →</button>
      </form>
    </div>
  </div>

  <!-- APP -->
  <div id="app">
    <aside class="sidebar">
      <div class="sidebar-brand">Auto<span>haus</span></div>
      <nav class="sidebar-nav">
        <a href="#" data-section="dashboard" class="active"
          >📊 Tableau de bord</a
        >
        <a href="#" data-section="users">👥 Utilisateurs</a>
        <a href="#" data-section="orders">📦 Commandes</a>
        <a href="#" data-section="claims">💳 Paiements à valider</a>
        <a href="#" data-section="deliveries">🚚 Livraisons</a>
        <a href="#" data-section="vehicles">🚗 Véhicules</a>
        <a href="#" data-section="reviews">⭐ Avis clients</a>
        <a href="#" data-section="sell-requests">📸 Demandes de vente</a>
        <a href="#" data-section="settings">⚙️ Informations du site</a>
        <a href="index.html" target="_blank">🌐 Voir le site</a>
      </nav>
      <div class="sidebar-footer">
        <div class="admin-name" id="admin-name">Admin</div>
        <div id="admin-email">—</div>
        <button
          class="btn btn-outline btn-sm"
          style="margin-top: 12px; width: 100%"
          id="logout-btn"
        >
          Déconnexion
        </button>
      </div>
    </aside>

    <main class="main">
      <!-- DASHBOARD -->
      <section id="section-dashboard" class="section active">
        <div class="page-header">
          <div>
            <h2>Tableau de bord</h2>
            <p>Vue d'ensemble de l'activité Autohaus</p>
          </div>
        </div>
        <div class="stats-grid" id="stats-grid">
          <!-- filled by JS -->
        </div>
      </section>

      <!-- USERS -->
      <section id="section-users" class="section">
        <div class="page-header">
          <div>
            <h2>Utilisateurs</h2>
            <p>Gérer les comptes clients et administrateurs</p>
          </div>
        </div>
        <div class="panel">
          <div class="panel-header">
            <h3>Liste des utilisateurs</h3>
            <input
              type="search"
              class="search-input"
              id="user-search"
              placeholder="Rechercher nom ou email…"
            />
          </div>
          <div class="table-wrap">
            <table>
              <thead>
                <tr>
                  <th>ID</th>
                  <th>Nom</th>
                  <th>Email</th>
                  <th>Téléphone</th>
                  <th>Vérifié</th>
                  <th>Actif</th>
                  <th>Admin</th>
                  <th>Commandes</th>
                  <th>Actions</th>
                </tr>
              </thead>
              <tbody id="users-tbody"></tbody>
            </table>
          </div>
        </div>
      </section>

      <!-- ORDERS -->
      <section id="section-orders" class="section">
        <div class="page-header">
          <div>
            <h2>Commandes</h2>
            <p>Suivi et gestion des commandes / livraisons</p>
          </div>
          <select class="status-select" id="order-filter">
            <option value="">Tous les statuts</option>
            <option value="pending">Pending</option>
            <option value="active">Active</option>
            <option value="paid">Paid</option>
            <option value="delivering">Delivering</option>
            <option value="delivered">Delivered</option>
            <option value="cancelled">Cancelled</option>
          </select>
        </div>
        <div class="panel">
          <div class="panel-header">
            <h3>Liste des commandes</h3>
          </div>
          <div class="table-wrap">
            <table>
              <thead>
                <tr>
                  <th>ID</th>
                  <th>Client</th>
                  <th>Véhicule</th>
                  <th>Prix</th>
                  <th>Payé</th>
                  <th>Type</th>
                  <th>Statut</th>
                  <th>Date</th>
                  <th>Actions</th>
                </tr>
              </thead>
              <tbody id="orders-tbody"></tbody>
            </table>
          </div>
        </div>
      </section>

      <!-- PAYMENT CLAIMS -->
      <section id="section-claims" class="section">
        <div class="page-header">
          <div>
            <h2>Paiements à valider</h2>
            <p>
              Le client a déclaré un virement — vérifiez votre compte bancaire
              puis validez ou refusez
            </p>
          </div>
          <select class="status-select" id="claims-filter">
            <option value="claimed">En attente</option>
            <option value="paid">Validés</option>
            <option value="rejected">Refusés</option>
            <option value="">Tous</option>
          </select>
        </div>
        <div class="panel">
          <div class="panel-header"><h3>Demandes de validation</h3></div>
          <div class="table-wrap">
            <table>
              <thead>
                <tr>
                  <th>Échéance</th>
                  <th>Client</th>
                  <th>Véhicule</th>
                  <th>Montant</th>
                  <th>Déclaré le</th>
                  <th>Statut</th>
                  <th>Actions</th>
                </tr>
              </thead>
              <tbody id="claims-tbody"></tbody>
            </table>
          </div>
        </div>
      </section>

      <!-- SELL REQUESTS -->
      <section id="section-sell-requests" class="section">
        <div class="page-header">
          <div>
            <h2>Demandes de vente</h2>
            <p>Estimations véhicules envoyées depuis la page « Vendre » — avec photos</p>
          </div>
          <select id="sellreq-filter" class="status-select" style="width:auto">
            <option value="">Tous les statuts</option>
            <option value="new">Nouvelles</option>
            <option value="contacted">Contactées</option>
            <option value="closed">Clôturées</option>
          </select>
        </div>
        <div class="panel">
          <div class="panel-header"><h3>Demandes d'estimation</h3></div>
          <div class="table-wrap">
            <table>
              <thead>
                <tr>
                  <th>ID</th>
                  <th>Client</th>
                  <th>Véhicule</th>
                  <th>Km</th>
                  <th>Photos</th>
                  <th>Statut</th>
                  <th>Date</th>
                  <th>Actions</th>
                </tr>
              </thead>
              <tbody id="sellreq-tbody"></tbody>
            </table>
          </div>
        </div>
      </section>

      <!-- REVIEWS -->
      <section id="section-reviews" class="section">
        <div class="page-header">
          <div>
            <h2>Avis clients</h2>
            <p>Modérez les témoignages : seuls les avis approuvés s'affichent sur le site</p>
          </div>
          <select id="reviews-filter" class="status-select" style="width:auto">
            <option value="">Tous</option>
            <option value="pending">En attente</option>
            <option value="approved">Approuvés</option>
          </select>
        </div>
        <div class="panel">
          <div class="panel-header"><h3>Témoignages</h3></div>
          <div class="table-wrap">
            <table>
              <thead>
                <tr>
                  <th>ID</th>
                  <th>Client</th>
                  <th>Véhicule</th>
                  <th>Note</th>
                  <th>Avis</th>
                  <th>Statut</th>
                  <th>Date</th>
                  <th>Actions</th>
                </tr>
              </thead>
              <tbody id="reviews-tbody"></tbody>
            </table>
          </div>
        </div>
      </section>

      <!-- SITE SETTINGS -->
      <section id="section-settings" class="section">
        <div class="page-header">
          <div>
            <h2>Informations du site</h2>
            <p>
              Chaque champ s'enregistre indépendamment. Les coordonnées de
              contact (téléphone, email, WhatsApp, adresse) sont appliquées
              aussitôt aux pages du site.
            </p>
          </div>
        </div>
        <div class="panel">
          <div class="panel-header"><h3>Coordonnées bancaires</h3></div>
          <div class="settings-fields">
            <form class="settings-form" data-sfield="bank_holder">
              <label for="s-bank-holder">Titulaire du compte</label>
              <input id="s-bank-holder" />
              <button type="submit" class="btn btn-primary btn-sm">
                Enregistrer
