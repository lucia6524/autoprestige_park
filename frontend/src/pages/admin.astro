          <div class="panel-header"><h3>Coordonnées de contact</h3></div>
          <div class="settings-fields">
            <form class="settings-form" data-sfield="contact_phone">
              <label for="s-phone">Téléphone</label>
              <input id="s-phone" placeholder="+33 1 42 86 82 00" />
              <button type="submit" class="btn btn-primary btn-sm">
                Enregistrer
              </button>
            </form>
            <form class="settings-form" data-sfield="contact_email">
              <label for="s-email">Email</label>
              <input id="s-email" type="email" placeholder="contact@autoprestige.fr" />
              <button type="submit" class="btn btn-primary btn-sm">
                Enregistrer
              </button>
            </form>
            <form class="settings-form" data-sfield="contact_whatsapp">
              <label for="s-whatsapp"
                >WhatsApp (indicatif pays, sans espaces) —
                <a
                  href="#"
                  id="s-whatsapp-test"
                  target="_blank"
                  rel="noopener"
                  style="display: none"
                  >Tester le numéro ↗</a
                ></label
              >
              <input id="s-whatsapp" placeholder="33142868200" />
              <button type="submit" class="btn btn-primary btn-sm">
                Enregistrer
              </button>
            </form>
            <form class="settings-form" data-sfield="contact_address">
              <label for="s-address">Adresse</label>
              <input id="s-address" />
              <button type="submit" class="btn btn-primary btn-sm">
                Enregistrer
              </button>
            </form>
          </div>
        </div>
      </section>

      <!-- DELIVERIES -->
      <section id="section-deliveries" class="section">
        <div class="page-header">
          <div>
            <h2>Livraisons</h2>
            <p>Valider les livraisons et suivre les commandes soldées.</p>
          </div>
          <button class="btn btn-outline btn-sm" onclick="loadDeliveries()">
            Actualiser
          </button>
        </div>
        <div class="panel">
          <div class="panel-header"><h3>Suivi des livraisons</h3></div>
          <div class="table-wrap">
            <table>
              <thead>
                <tr>
                  <th>Commande</th>
                  <th>Client</th>
                  <th>Véhicule</th>
                  <th>Destinataire</th>
                  <th>Suivi</th>
                  <th>Statut</th>
                  <th>Actions</th>
                </tr>
              </thead>
              <tbody id="deliveries-tbody"></tbody>
            </table>
          </div>
        </div>
      </section>

      <!-- VEHICLES -->
      <section id="section-vehicles" class="section">
        <div class="page-header">
          <div>
            <h2>Véhicules</h2>
            <p>CRUD voitures, camping-cars et machines agricoles</p>
          </div>
          <div
            style="
              display: flex;
              gap: 10px;
              flex-wrap: wrap;
              align-items: center;
            "
          >
            <select class="status-select" id="veh-category-filter">
              <option value="">Toutes catégories</option>
              <option value="voiture">Voitures</option>
              <option value="camping-car">Camping-cars</option>
              <option value="machine-agricole">Machines agricoles</option>
            </select>
            <button class="btn btn-primary btn-sm" id="btn-add-vehicle">
              + Ajouter
            </button>
          </div>
        </div>
        <div
          class="panel"
          id="vehicle-form-panel"
          style="display: none; margin-bottom: 20px"
        >
          <div class="panel-header">
            <h3 id="vehicle-form-title">Nouveau véhicule</h3>
          </div>
          <form
            id="vehicle-form"
            style="
              padding: 20px;
              display: grid;
              grid-template-columns: 1fr 1fr;
              gap: 14px;
            "
          >
            <input type="hidden" id="v-id" />
            <div class="form-group">
              <label>Catégorie</label>
              <select
                id="v-category"
                class="status-select"
                style="width: 100%; padding: 10px"
                required
              >
                <option value="voiture">Voiture</option>
                <option value="camping-car">Camping-car</option>
                <option value="machine-agricole">Machine agricole</option>
              </select>
            </div>
            <div class="form-group">
              <label>Type</label>
              <select
                id="v-type"
                class="status-select"
                style="width: 100%; padding: 10px"
