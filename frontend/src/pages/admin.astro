            <form class="settings-form" data-sfield="bank_transfer_type">
              <label for="s-bank-transfer">Type de virement</label>
              <input id="s-bank-transfer" />
              <button type="submit" class="btn btn-primary btn-sm">
                Enregistrer
              </button>
            </form>
            <form class="settings-form" data-sfield="bank_iban">
              <label for="s-bank-iban">IBAN</label>
              <input id="s-bank-iban" />
              <button type="submit" class="btn btn-primary btn-sm">
                Enregistrer
              </button>
            </form>
            <form class="settings-form" data-sfield="bank_bic">
              <label for="s-bank-bic">BIC</label>
