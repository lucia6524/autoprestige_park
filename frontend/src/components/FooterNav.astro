---
// Bloc "Navigation" du footer : liste de liens traduits
import { NAV_LINKS, fText, fHref } from '../data/footer-links';
import { getDict, type Locale } from '../i18n/site';

interface Props {
  /** Clés i18n autorisées : sous-ensemble de NAV_LINKS */
  links: string[];
  /** Build-time i18n : langue de l'arbre (absent = pages FR racine) */
  lang?: Locale;
}
const { links, lang } = Astro.props;
const ctx = lang ? { lang, dict: getDict(lang) } : undefined;
---

<div>
  <h4 data-i18n="footer.navigation">{fText(ctx, 'footer.navigation', 'Navigation')}</h4>
  <div class="footer-links">
    {links.map((key) => {
      const link = NAV_LINKS[key];
      return (
        <a href={fHref(ctx, link.href)} data-i18n={link.i18n}>
          {fText(ctx, link.i18n, link.text)}
        </a>
      );
    })}
  </div>
</div>
