---
// Bloc "Navigation" du footer : liste de liens
import { NAV_LINKS } from '../data/footer-links';

interface Props {
  /** Clés autorisées : sous-ensemble de NAV_LINKS */
  links: string[];
}
const { links } = Astro.props;
---

<div>
  <h4>Navigation</h4>
  <div class="footer-links">
    {links.map((key) => {
      const link = NAV_LINKS[key];
      return <a href={link.href}>{link.text}</a>;
    })}
  </div>
</div>
