---
// Header localisé : rendu serveur depuis le dictionnaire de build (aucune
// clé data-i18n : le texte est déjà traduit, i18n.js n'est pas chargé).
// data-static est conservé : header.js branche ses comportements dessus
// (burger, dropdown, thème, auth) — et il est 100 % défensif sur I18N.
import { linkFor, assetFor, getDict, t, type Locale } from '../i18n/site';

interface Props {
  lang: Locale;
  currentFile: string;
}
const { lang, currentFile } = Astro.props;
const dict = getDict(lang);

const PAGES = {
  home: 'index.html',
  vehicles: 'vehicules.html',
  financing: 'financement.html',
  sell: 'vendre.html',
  contact: 'contact.html',
  brands: 'marques.html',
  warranty: 'garantie.html',
  rv: 'camping-car.html',
  agri: 'machines-agricoles.html',
  insurance: 'assurance.html',
  delivery: 'livraison.html',
  maintenance: 'entretien.html',
  faq: 'faq.html',
  about: 'a-propos.html',
  reviews: 'avis.html',
  login: 'connexion.html',
  register: 'inscription.html',
  account: 'compte.html',
};
const isActive = (file: string) => (currentFile === file ? 'active' : '');
const nav = (key: string, file: string, fallback: string) => ({
  href: linkFor(file, lang),
  label: t(dict, `nav.${key}`, fallback),
  active: isActive(file),
});
const main = [
  nav('home', PAGES.home, 'Home'),
  nav('vehicles', PAGES.vehicles, 'Vehicles'),
  nav('financing', PAGES.financing, 'Financing'),
  nav('sell', PAGES.sell, 'Sell'),
  nav('contact', PAGES.contact, 'Contact'),
];
const more = [
  nav('brands', PAGES.brands, 'Brands'),
  nav('warranty', PAGES.warranty, 'Warranty'),
  nav('rv', PAGES.rv, 'Motorhome'),
  nav('agri', PAGES.agri, 'Farm machinery'),
  nav('insurance', PAGES.insurance, 'Insurance'),
  nav('delivery', PAGES.delivery, 'Delivery'),
  nav('maintenance', PAGES.maintenance, 'Maintenance'),
  nav('faq', PAGES.faq, 'FAQ'),
  nav('about', PAGES.about, 'About us'),
  nav('reviews', PAGES.reviews, 'Reviews'),
];
---

<header class="header" id="main-header" translate="no" data-static>
  <div class="container header-inner">
    <a href={linkFor(PAGES.home, lang)} class="logo" data-no-translate aria-label="Autohaus — Home">
      <img src={assetFor('logo.png', lang)} alt="Autohaus" />
    </a>

    <nav class="nav" id="main-nav" aria-label="Navigation">
      <div class="mobile-user" id="mobile-user"></div>
      {main.map((item) => <a href={item.href} class={item.active}>{item.label}</a>)}

      <div class="nav-item" id="nav-more">
        <a
          href="#"
          class="nav-more-toggle"
          aria-haspopup="true"
          aria-expanded="false"
        >
          {t(dict, 'nav.more', 'More')}
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
        </a>
        <div class="dropdown" role="menu">
          {more.map((item) => <a href={item.href} class={item.active}>{item.label}</a>)}
          <div class="dropdown-divider"></div>
          <a href={linkFor(PAGES.register, lang)} class={isActive(PAGES.register)}>{t(dict, 'nav.register', 'Sign up')}</a>
          <a href={linkFor(PAGES.login, lang)} class={isActive(PAGES.login)}>{t(dict, 'nav.login', 'Log in')}</a>
        </div>
      </div>
    </nav>

    <div class="header-actions">
      <button type="button" class="theme-toggle" id="theme-toggle" aria-label="Toggle theme">
        <svg class="icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path></svg>
        <svg class="icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"></circle><line x1="12" y1="1" x2="12" y2="3"></line><line x1="12" y1="21" x2="12" y2="23"></line><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line><line x1="1" y1="12" x2="3" y2="12"></line><line x1="21" y1="12" x2="23" y2="12"></line><line x1="23" y1="12" x2="23" y2="12"></line><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line></svg>
      </button>
      <div class="header-auth" id="header-auth">
        <a href={linkFor(PAGES.login, lang)} class="header-auth-link">{t(dict, 'nav.login', 'Log in')}</a>
      </div>
      <button type="button" class="mobile-toggle" aria-label="Menu" id="mobile-toggle">
        <span aria-hidden="true">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
        </span>
      </button>
    </div>
  </div>
</header>
