---
// Bloc "Marque" du footer : logo + tagline
import { getTagline, fHref } from '../data/footer-links';
import { getDict, type Locale } from '../i18n/site';

interface Props {
  /** 'full' | 'default' | 'custom' — voir footer-links.ts */
  variant?: 'full' | 'default' | 'custom';
  /** Texte libre si variant="custom" */
  tagline?: string;
  /** Build-time i18n : langue de l'arbre (absent = pages FR racine) */
  lang?: Locale;
}
const { variant = 'default', tagline, lang } = Astro.props;
const ctx = lang ? { lang, dict: getDict(lang) } : undefined;
const t = getTagline(variant, tagline, ctx);
---

<div class="footer-brand">
  <a href={fHref(ctx, 'index.html')} class="logo" data-no-translate>
    <img src={lang ? '../logo.png' : 'logo.png'} alt="Autohaus" />
    Auto<span>haus</span>
  </a>
  {t.i18n ? <p data-i18n="footer.tagline">{t.text}</p> : <p>{t.text}</p>}
</div>
