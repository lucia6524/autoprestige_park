---
// Bloc "Services" du footer : liste de liens
import { SERVICE_LINKS } from '../data/footer-links';

interface Props {
  /** Clés autorisées : sous-ensemble de SERVICE_LINKS */
  links: string[];
}
const { links } = Astro.props;
---

<div>
  <h4>Services</h4>
  <div class="footer-links">
    {links.map((key) => {
      const link = SERVICE_LINKS[key];
      return <a href={link.href}>{link.text}</a>;
    })}
  </div>
</div>
