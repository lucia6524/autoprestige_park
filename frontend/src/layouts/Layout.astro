---
// Gabarit commun : head, header statique + footer partagés, scripts communs.
// Les pages passent leurs options footer via props (footer={...}).
// header.js détecte le header statique et s'y branche — plus d'injection DOM.
// Traduction : widget GTranslate free (gtranslate.net, traduction côté
// navigateur) — config + chargement CDN ici, sélecteur dans Header.astro.
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import type { FooterOptions } from '../types';

interface Props {
  title: string;
  description?: string;
  footer?: FooterOptions;
  scripts?: string[];
  // Pages qui gèrent elles-mêmes leurs scripts (ex. compte, connexion,
  // inscription) pour préserver l'ordre exact des pages HTML d'origine.
  ownScripts?: boolean;
}

const {
  title,
  description = "Autohaus : votre spécialiste en véhicules neufs et d'occasion. Financement sur mesure, livraison rapide, garantie jusqu'à 24 mois.",
  footer = {},
  scripts = [],
  ownScripts = false,
} = Astro.props;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <link rel="icon" type="image/png" href="favicon.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://ridnurabtydwlymzdexk.supabase.co" />
    <link rel="preconnect" href="https://cdn.gtranslate.net" crossorigin />
    <link rel="preconnect" href="https://translate.googleapis.com" crossorigin />
    <link rel="preload" as="font" type="font/woff2" href="fonts/inter-var.woff2" crossorigin />
    <link rel="stylesheet" href="css/style.css" />
    <script is:inline>
      var p = localStorage.getItem('theme');
      if (p !== 'light' && p !== 'dark') p = 'dark';
      document.documentElement.setAttribute('data-theme', p);
    </script>
    <!-- GTranslate (traduction côté navigateur) : applique la langue
         mémorisée AVANT le premier paint si le CDN est en cache — sinon le
         court CSS .gt-wait ci-dessous masque le texte jusqu'à application. -->
    <script is:inline>
      window.gtranslateSettings = {
        default_language: 'fr',
        languages: ['fr', 'en', 'de', 'it', 'es', 'pt', 'ro'],
        wrapper_selector: '.gtranslate_wrapper',
        url_structure: 'none', // traduction client, aucune URL /en/
        detect_browser_language: true, // auto-traduit les navigateurs non FR
        native_language_names: true,
        select_language_label: 'Choisir la langue',
      };
    </script>
    <style is:global>
      /* Sélecteur GTranslate calé sur le style du header (mode sombre/clair) */
      .gtranslate_wrapper {
        display: inline-flex;
        align-items: center;
        order: -1;
      }
      .gtranslate_wrapper select.gt_selector {
        appearance: none;
        -webkit-appearance: none;
        border: 1px solid var(--border);
        background: transparent;
        color: var(--text-secondary);
        border-radius: 8px;
        font: 600 0.8rem/1.2 'Inter', system-ui, sans-serif;
        padding: 6px 24px 6px 10px;
        cursor: pointer;
        max-width: 150px;
        transition: border-color 0.2s ease, color 0.2s ease;
      }
      .gtranslate_wrapper select.gt_selector:hover,
      .gtranslate_wrapper select.gt_selector:focus {
        border-color: var(--accent);
        color: var(--text-primary);
        outline: none;
      }
      .gtranslate_wrapper select.gt_selector option {
        background: #fff;
        color: #111827;
      }
      html[data-theme='dark'] .gtranslate_wrapper select.gt_selector option {
        background: #1a1a24;
        color: #f1f1f6;
      }
      @media (max-width: 768px) {
        .gtranslate_wrapper select.gt_selector {
          max-width: 118px;
          padding: 6px 20px 6px 8px;
          font-size: 0.72rem;
        }
      }
      /* Cache la bannière Google « Traduit par » en haut de page */
      body {
        top: 0 !important;
      }
      .skiptranslate iframe {
        display: none !important;
      }
    </style>
    <!-- Overlay loader : logo Autohaus qui tourne (voir js/loader.js) -->
    <script is:inline data-ap-loader>
      (function () {
        try {
          var css =
            "#ap-loader-overlay{position:fixed;inset:0;z-index:99999;" +
            "display:flex;align-items:center;justify-content:center;" +
            "background:rgba(248,248,252,.6);backdrop-filter:blur(4px);" +
            "opacity:0;pointer-events:none;transition:opacity .22s ease}" +
            "html[data-theme='dark'] #ap-loader-overlay{background:rgba(9,9,14,.62)}" +
            "#ap-loader-overlay.show{opacity:1;pointer-events:auto}" +
            "#ap-loader-overlay .ap-logo-spin{width:92px;height:92px;" +
            "object-fit:contain;" +
            "filter:drop-shadow(0 6px 18px rgba(0,0,0,.25));animation:ap-spin 1.1s linear infinite}" +
            "html[data-theme='light'] #ap-loader-overlay .ap-logo-spin{filter:invert(1) drop-shadow(0 6px 18px rgba(0,0,0,.25))}" +
            "@keyframes ap-spin{to{transform:rotate(360deg)}}" +
            "@media (prefers-reduced-motion:reduce){#ap-loader-overlay .ap-logo-spin{animation-duration:2.6s}}";
          var s = document.createElement('style');
          s.textContent = css;
          (document.head || document.documentElement).appendChild(s);
          var o = document.createElement('div');
          o.id = 'ap-loader-overlay';
          o.className = 'show';
          o.innerHTML =
            '<img class="ap-logo-spin" src="logo.png" alt="" aria-hidden="true">';
        } catch (e) {}
      })();
    </script>
    <script src="js/loader.js" defer is:inline></script>
    <script is:inline>
      // Enregistre le service worker (cache des assets) — jamais bloquant.
      if ('serviceWorker' in navigator && location.protocol === 'https:') {
        window.addEventListener('load', function () {
          navigator.serviceWorker.register('/sw.js').catch(function () {});
        });
      }
    </script>
  </head>
  <body>
    <Header />

    <slot />

    <Footer {...footer} />

    {
      !ownScripts && (
        <>
          <script src="js/header.js" defer is:inline />
          <script src="js/gtranslate.js" defer is:inline />
          <script src="https://cdn.gtranslate.net/widgets/latest/dropdown.js" defer is:inline />
          <script src="js/api.js" defer is:inline />
          {scripts.map((src) => (
            <script src={src} defer is:inline />
          ))}
          <script src="js/main.js" defer is:inline />
        </>
      )
    }

    {
      ownScripts && (
        <>
          <script src="js/gtranslate.js" defer is:inline />
          <script src="https://cdn.gtranslate.net/widgets/latest/dropdown.js" defer is:inline />
        </>
      )
    }
  </body>
</html>
