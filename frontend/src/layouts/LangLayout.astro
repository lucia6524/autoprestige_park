---
// Gabarit des pages localisées (POC : /en/) — copie conforme de Layout.astro
// avec contenu TRADUIT AU BUILD (aucune traduction runtime sur ces pages :
// i18n.js n'y est pas chargé). Assets/liens préfixés ../ (un niveau de
// dossier de plus). SEO : canonical absolu + hreflang vers les variantes
// RÉELLEMENT existantes uniquement (voir site.ts EN_PAGES).
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import LangHeader from '../components/LangHeader.astro';
import type { FooterOptions } from '../types';
import { SITE_URL, LOCALES, LOCALIZED_PAGES, type Locale } from '../i18n/site';

interface Props {
  lang: Locale;
  /** Chemin du fichier cible dans l'arbre, ex. 'contact.html' */
  file: string;
  title: string;
  description: string;
  footer?: FooterOptions;
}

const { lang, file, title, description, footer = {} } = Astro.props;
const asset = (p: string) => (lang === 'fr' ? p : `../${p}`);
const canonical = `${SITE_URL}/${lang === 'fr' ? '' : lang + '/'}${file}`;

// hreflang : uniquement les variantes qui EXISTENT réellement (FR toujours,
// sinon les langues dont la page est générée — LOCALIZED_PAGES). x-default → FR.
const alternates: { hreflang: string; href: string }[] = [
  { hreflang: 'fr', href: `${SITE_URL}/${file}` },
  { hreflang: 'x-default', href: `${SITE_URL}/${file}` },
];
for (const code of LOCALES) {
  if (code === 'fr') continue;
  if (LOCALIZED_PAGES[code]?.has(file)) {
    alternates.push({ hreflang: code, href: `${SITE_URL}/${code}/${file}` });
  }
}
---

<!doctype html>
<html lang={lang} data-static-i18n>
  <head>
    <meta charset="UTF-8" />
    <link rel="icon" type="image/png" href={asset('favicon.png')} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
    <link rel="preconnect" href="https://ridnurabtydwlymzdexk.supabase.co" />
    <link rel="preload" as="font" type="font/woff2" href={asset('fonts/inter-var.woff2')} crossorigin />
    <link rel="stylesheet" href={asset('css/style.css')} />
    <script is:inline>
      var p = localStorage.getItem('theme');
      if (p !== 'light' && p !== 'dark') p = 'dark';
      document.documentElement.setAttribute('data-theme', p);
    </script>
    <!-- Pages localisées existantes, générées au build depuis site.ts :
         le sélecteur de langue navigue vers la variante si elle existe,
         sinon vers la version FR (jamais de lien mort). -->
    <script is:inline define:vars={{ pagesJson: JSON.stringify(Object.fromEntries(Object.entries(LOCALIZED_PAGES).map(([k, v]) => [k, [...v]]))) }}>
      window.AP_I18N_PAGES = JSON.parse(pagesJson);
    </script>
    <!-- Overlay loader : logo Autohaus qui tourne (voir js/loader.js) -->
    <script is:inline data-ap-loader>
      (function () {
        try {
          var css =
            "#ap-loader-overlay{position:fixed;inset:0;z-index:99999;" +
            "display:flex;align-items:center;justify-content:center;" +
            "background:rgba(248,248,252,.6);backdrop-filter:blur(4px);" +
            "opacity:0;pointer-events:none;transition:opacity .22s ease}" +
            "html[data-theme='dark'] #ap-loader-overlay{background:rgba(9,9,14,.62)}" +
            "#ap-loader-overlay.show{opacity:1;pointer-events:auto}" +
            "#ap-loader-overlay .ap-logo-spin{width:92px;height:92px;" +
            "object-fit:contain;" +
            "filter:drop-shadow(0 6px 18px rgba(0,0,0,.25));animation:ap-spin 1.1s linear infinite}" +
            "html[data-theme='light'] #ap-loader-overlay .ap-logo-spin{filter:invert(1) drop-shadow(0 6px 18px rgba(0,0,0,.25))}" +
            "@keyframes ap-spin{to{transform:rotate(360deg)}}" +
            "@media (prefers-reduced-motion:reduce){#ap-loader-overlay .ap-logo-spin{animation-duration:2.6s}}";
          var s = document.createElement('style');
          s.textContent = css;
          (document.head || document.documentElement).appendChild(s);
          var o = document.createElement('div');
          o.id = 'ap-loader-overlay';
          o.className = 'show';
          o.innerHTML =
            '<img class="ap-logo-spin" src="' +
            (document.documentElement.getAttribute('lang') === 'fr' ? '' : '../') +
            'logo.png" alt="" aria-hidden="true">';
          document.documentElement.appendChild(o);
        } catch (e) {}
      })();
    </script>
    <script src={asset('js/loader.js')} defer is:inline></script>
  </head>
  <body>
    <LangHeader lang={lang} currentFile={file} />

    <slot />

    <Footer {...footer} lang={lang} />

    <!-- Mode navigation d'i18n.js : sélecteur de langue + libellés du
         dictionnaire (footer), mais AUCUNE traduction runtime (la page est
         déjà traduite au build) et changement de langue = navigation. -->
    <script src={asset('js/header.js')} defer is:inline></script>
    <script src={asset('js/i18n.js')} defer is:inline></script>
    <script src={asset('js/api.js')} defer is:inline></script>
    <script src={asset('js/main.js')} defer is:inline></script>
  </body>
