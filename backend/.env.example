# Copie ce fichier en .env et remplis tes identifiants
# cp .env.example .env

SECRET_KEY=change-moi-en-production-longue-cle-aleatoire
ENVIRONMENT=development

# Base de données
# Local SQLite (development)
# DATABASE_URL=sqlite+aiosqlite:///./data/autoprestige.db
# Render PostgreSQL: copy the Internal Database URL into this variable
# DATABASE_URL=postgresql://user:password@host/database

# --- Gmail SMTP (envoi réel des codes OTP) ---
# 1. Active la validation en 2 étapes sur ton compte Google
# 2. Crée un "Mot de passe d'application" :
#    https://myaccount.google.com/apppasswords
# 3. Colle le mot de passe de 16 caractères ci-dessous

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=ton.email@gmail.com
SMTP_PASSWORD=xxxx xxxx xxxx xxxx
SMTP_FROM=noreply@autoprestige.fr

# DeepL (traduction automatique invisible)
DEEPL_API_KEY=ta-cle-api-deepl
DEEPL_API_URL=https://api-free.deepl.com/v2/translate

OTP_EXPIRE_MINUTES=10

# Compte admin créé automatiquement au démarrage
ADMIN_EMAIL=admin@autoprestige.fr
ADMIN_PASSWORD=Admin@Prestige2026
