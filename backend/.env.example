[TEMPLATE]
# Copie ce fichier en .env et remplis tes identifiants
# cp .env.example .env

# ⚠️ Obligatoire en production : clé d'au moins 32 caractères, générée aléatoirement
SECRET_KEY=

ENVIRONMENT=development

# Base de données
# Local SQLite (development)
# DATABASE_URL=sqlite+aiosqlite:///./data/autoprestige.db
# Render PostgreSQL: copy the Internal Database URL into this variable
# DATABASE_URL=postgresql://user:password@host/database

# --- Email (SMTP) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=ton.email@gmail.com
SMTP_PASSWORD=xxxx xxxx xxxx xxxx
SMTP_FROM=noreply@autoprestige.fr

# DeepL (traduction automatique)
DEEPL_API_KEY=ta-cle-api-deepl
DEEPL_API_URL=https://api-free.deepl.com/v2/translate

OTP_EXPIRE_MINUTES=10

# ⚠️ Obligatoire en production : mot de passe admin (min 12 caractères)
ADMIN_EMAIL=admin@autoprestige.fr
ADMIN_PASSWORD=
