# Copie ce fichier en .env et remplis tes identifiants
# cp .env.example .env

# ⚠️ Obligatoire en production : clé d'au moins 32 caractères, générée aléatoirement
SECRET_KEY=

ENVIRONMENT=development

# Base de données
# Local SQLite (development)
# DATABASE_URL=sqlite+aiosqlite:///./data/autoprestige.db
# Render PostgreSQL: copy the Internal Database URL into this variable
# DATABASE_URL=postgresql://user:password@host/database

# --- Email (Brevo SMTP) ---
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=b7c0a1001@smtp-brevo.com
SMTP_PASSWORD=ta-cle-smtp-brevo
SMTP_FROM=autoprestigepark@outlook.com
CONTACT_RECIPIENT_EMAIL=autoprestigepark@outlook.com

# --- Traduction automatique (dynamique) ---
# Fournisseur : google (recommandé — 500 000 caractères/mois gratuits) ou deepl
TRANSLATION_PROVIDER=google
GOOGLE_TRANSLATE_API_KEY=ta-cle-api-google-cloud-translation
GOOGLE_TRANSLATE_API_URL=https://translation.googleapis.com/language/translate/v2

# DeepL (alternative — plan gratuit limité à 1M de caractères au total)
DEEPL_API_KEY=ta-cle-api-deepl
DEEPL_API_URL=https://api-free.deepl.com/v2/translate

OTP_EXPIRE_MINUTES=10

# ⚠️ Obligatoire en production : mot de passe admin (min 12 caractères)
ADMIN_EMAIL=admin@autoprestige.fr
ADMIN_PASSWORD=
